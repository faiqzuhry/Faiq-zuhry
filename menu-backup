#!/bin/bash
set -u

# ============================================================
# MUMMY - Backup & Restore Menu
# ============================================================

DATA_DIR="/etc/data"
CONFIG_FILE="${DATA_DIR}/telegram_config.conf"
NAME_FILE="${DATA_DIR}/nama"
FILE_ID_FILE="${DATA_DIR}/file_id.txt"
LOG_FILE="${DATA_DIR}/log-backup.txt"
BACKUP_DIR="/root/backup"

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Skrip ini harus dijalankan sebagai root."
    exit 1
fi

mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"

green() { printf '\033[32;1m%s\033[0m\n' "$*"; }
red()   { printf '\033[31;1m%s\033[0m\n' "$*"; }

print_header() {
    clear
    echo "**************************************************"
    echo "*                                                *"
    echo "*       Backup and Restore Options Menu          *"
    echo "*                                                *"
    echo "**************************************************"
    echo
}

save_telegram_config() {
    local bot chat
    read -r -p "Enter your Telegram bot token: " bot
    read -r -p "Enter your Telegram user ID: " chat

    if [ -z "$bot" ] || [ -z "$chat" ]; then
        red "Bot token dan user ID tidak boleh kosong."
        return 1
    fi

    umask 077
    {
        printf 'botToken=%q\n' "$bot"
        printf 'chatId=%q\n' "$chat"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    green "Konfigurasi Telegram berhasil disimpan."
}

load_telegram_config() {
    if [ ! -s "$CONFIG_FILE" ]; then
        echo "Konfigurasi Telegram belum tersedia."
        save_telegram_config || return 1
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    if [ -z "${botToken:-}" ] || [ -z "${chatId:-}" ]; then
        red "Konfigurasi Telegram tidak valid."
        return 1
    fi
}

get_server_name() {
    local n="server"
    if [ -s "$NAME_FILE" ]; then
        n="$(tr -d '\r\n' < "$NAME_FILE")"
    fi
    n="${n//[^a-zA-Z0-9._-]/_}"
    [ -n "$n" ] || n="server"
    printf '%s' "$n"
}

get_public_ip() {
    local ip
    ip="$(curl -4fsS --connect-timeout 8 --max-time 15 https://api.ipify.org 2>/dev/null || true)"
    [ -n "$ip" ] && printf '%s' "$ip" || printf 'Unknown'
}

html_escape() {
    local v="$1"
    v="${v//&/&amp;}"
    v="${v//</&lt;}"
    v="${v//>/&gt;}"
    v="${v//\"/&quot;}"
    printf '%s' "$v"
}

check_requirements() {
    local missing=()
    for cmd in curl jq zip unzip docker crontab sqlite3; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        red "Command belum tersedia: ${missing[*]}"
        return 1
    fi
}

backup_and_send_telegram() {
    print_header

    load_telegram_config || return 1

    check_requirements || return 1

    local nama tanggal tanggal2 waktu curdir response ok file_id
    local IP_ADDRESS CLIENT_NAME_ESCAPED IP_ADDRESS_ESCAPED CAPTION
    nama="$(get_server_name)"
    tanggal="$(date '+%m-%d-%Y')"
    tanggal2="$(date '+%m%d%Y')"
    waktu="$(date '+%H%M%S')"

    if [ ! -d /opt/marzban ] || [ ! -f /var/lib/marzban/db.sqlite3 ]; then
        red "Data Marzban tidak lengkap. Backup dibatalkan."
        return 1
    fi

    rm -rf "$BACKUP_DIR"
    mkdir -p "$BACKUP_DIR"

    echo "Memulai Backup..."
    cp -a /opt/marzban "$BACKUP_DIR/" || { red "Gagal backup /opt/marzban."; rm -rf "$BACKUP_DIR"; return 1; }
    cp -a /var/lib/marzban/db.sqlite3 "$BACKUP_DIR/" || { red "Gagal backup database."; rm -rf "$BACKUP_DIR"; return 1; }

    for item in \
        /var/lib/marzban/xray_config.json \
        /var/lib/marzban/max_ips.conf \
        /var/lib/marzban/xray.crt \
        /var/lib/marzban/xray.key \
        /var/www/html \
        "$CONFIG_FILE" \
        "$FILE_ID_FILE"
    do
        [ -e "$item" ] && cp -a "$item" "$BACKUP_DIR/" || true
    done

    curdir="/root/${nama}_${waktu}_${tanggal2}.zip"
    rm -f "$curdir"

    if ! (cd /root && zip -r -q "$(basename "$curdir")" "$(basename "$BACKUP_DIR")"); then
        red "Gagal membuat file ZIP."
        rm -rf "$BACKUP_DIR"
        return 1
    fi

    # Informasi yang ditampilkan pada caption Telegram.
    IP_ADDRESS="$(get_public_ip)"
    CLIENT_NAME="$nama"

    # Escape HTML agar nama client/IP tidak merusak parse_mode=HTML.
    CLIENT_NAME_ESCAPED="$(html_escape "$CLIENT_NAME")"
    IP_ADDRESS_ESCAPED="$(html_escape "$IP_ADDRESS")"

    CAPTION="$(printf '%s\n' \
        '=================================' \
        '『 Successfully backup your Database 』' \
        '=================================' \
        "◈ Client  : <code>${CLIENT_NAME_ESCAPED}</code>" \
        "◈ IP VPS  : <code>${IP_ADDRESS_ESCAPED}</code>" \
        '◈ Version  : 3.1 Stable' \
        '◈ Built By  : @Faiqzuhry' \
        '=================================')"

    echo "Mengirim file backup ke bot Telegram..."

    response="$(
        curl -fsS --connect-timeout 15 --max-time 600 \
            -F "chat_id=${chatId}" \
            -F "document=@${curdir}" \
            -F "caption=${CAPTION}" \
            -F "parse_mode=HTML" \
            "https://api.telegram.org/bot${botToken}/sendDocument" 2>/dev/null
    )"
    local curl_status=$?

    ok="$(printf '%s' "$response" | jq -r '.ok // false' 2>/dev/null)"
    file_id="$(printf '%s' "$response" | jq -r '.result.document.file_id // empty' 2>/dev/null)"

    if [ "$curl_status" -ne 0 ] || [ "$ok" != "true" ] || [ -z "$file_id" ]; then
        red "Gagal mengirim backup ke Telegram."
        [ -n "$response" ] && printf '%s\n' "$response"
        red "File backup tetap disimpan di: $curdir"
        rm -rf "$BACKUP_DIR"
        return 1
    fi

    {
        printf '### %s_%s_%s\n' "$nama" "$waktu" "$tanggal"
        printf 'File ID: %s\n' "$file_id"
        printf 'Server telah berhasil backup data pada tanggal %s pukul %s.\n' "$tanggal" "$waktu"
    } >> "$FILE_ID_FILE"

    printf '%s - Backup berhasil dikirim: %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$curdir" >> "$LOG_FILE"

    rm -rf "$BACKUP_DIR"
    rm -f "$curdir"

    green "Backup berhasil dibuat dan dikirim ke Telegram."
    echo "File ID: $file_id"

    command -v profile >/dev/null 2>&1 && profile || true
}

set_backup_timer() {
    print_header
    echo "1. Set Daily Backup Timer"
    echo "2. Set Weekly Backup Timer"
    echo "3. Set Monthly Backup Timer"
    echo "4. Back to Main Menu"
    read -r -p "Enter your choice (1-4): " choice

    local t h m d
    case "$choice" in
        1)
            read -r -p "Daily time (HH:MM): " t
            if [[ ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Format waktu salah."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup daily'; echo "$m $h * * * /usr/bin/backup daily") | crontab -
            ;;
        2)
            read -r -p "Day (0-6, Sunday-Saturday): " d
            read -r -p "Weekly time (HH:MM): " t
            if [[ ! "$d" =~ ^[0-6]$ || ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Input tidak valid."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup weekly'; echo "$m $h * * $d /usr/bin/backup weekly") | crontab -
            ;;
        3)
            read -r -p "Day of month (1-31): " d
            read -r -p "Monthly time (HH:MM): " t
            if [[ ! "$d" =~ ^([1-9]|[12][0-9]|3[01])$ || ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Input tidak valid."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup monthly'; echo "$m $h $d * * /usr/bin/backup monthly") | crontab -
            ;;
        4) return 0 ;;
        *) red "Pilihan tidak valid."; return 1 ;;
    esac

    green "Backup timer berhasil disimpan."
}

remove_backup_timer() {
    print_header
    echo "1. Remove Daily Backup Timer"
    echo "2. Remove Weekly Backup Timer"
    echo "3. Remove Monthly Backup Timer"
    echo "4. Back to Main Menu"
    read -r -p "Enter your choice (1-4): " choice

    case "$choice" in
        1) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup daily') | crontab - ;;
        2) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup weekly') | crontab - ;;
        3) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup monthly') | crontab - ;;
        4) return 0 ;;
        *) red "Pilihan tidak valid."; return 1 ;;
    esac
    green "Backup timer berhasil dihapus."
}

restore_from_telegram() {
    print_header
    load_telegram_config || return 1

    # Restore harus mengambil FILE BARU yang dikirim ke bot.
    # Sebelum menunggu, hentikan sementara service lain yang mungkin memakai
    # getUpdates (mis. check-usage.service), supaya update file tidak dimakan
    # service lain lebih dahulu.
    local FILE_ID="" FILE_PATH="" FILE_NAME="" TMP_DIR="" ZIP_FILE=""
    local SAFETY_DIR="" COMPOSE_DIR="" DB_FILE="" TG_UPDATES=""
    local FOUND_JSON="" GETFILE_JSON="" OK="" CONTAINER_NAMES=""
    local BASELINE_ID="" NEXT_OFFSET="1" LAST_UPDATE_ID=""
    local WAIT_SECONDS=300
    local POLL_SERVICES=("check-usage.service" "bot-usage.service")
    local STOPPED_SERVICES=()

    echo "=== RESTORE OTOMATIS DARI FILE TELEGRAM ==="

    for cmd in curl jq unzip docker sqlite3; do
        command -v "$cmd" >/dev/null 2>&1 || { red "Command belum tersedia: $cmd"; return 1; }
    done
    [ -d /opt/marzban ] || { red "/opt/marzban belum tersedia. Selesaikan install Marzban terlebih dahulu."; return 1; }

    echo "[1/8] Menyiapkan Telegram..."

    # getUpdates tidak dapat dipakai bila webhook aktif.
    curl -fsS --connect-timeout 10 --max-time 20 \
        "https://api.telegram.org/bot${botToken}/deleteWebhook?drop_pending_updates=false" \
        >/dev/null 2>&1 || true

    # Hentikan sementara bot lain yang menggunakan polling Telegram.
    # Ini penting agar file yang baru dikirim tidak langsung diambil service lain.
    local svc
    for svc in "${POLL_SERVICES[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            systemctl stop "$svc" >/dev/null 2>&1 || true
            if ! systemctl is-active --quiet "$svc" 2>/dev/null; then
                STOPPED_SERVICES+=("$svc")
            fi
        fi
    done

    telegram_get_updates() {
        local offset="${1:-}"
        local url="https://api.telegram.org/bot${botToken}/getUpdates?limit=100&timeout=5&allowed_updates=%5B%22message%22%5D"
        [ -n "$offset" ] && url="${url}&offset=${offset}"
        curl -fsS --connect-timeout 15 --max-time 30 "$url" 2>/dev/null || true
    }

    find_document_in_updates() {
        printf '%s' "$1" | jq -r --arg chat "$chatId" '
          [ .result[]?
            | .message? as $m
            | select($m != null and ($m.chat.id|tostring) == $chat)
            | select($m.document != null)
            | {
                update_id: (.update_id // 0),
                date: ($m.date // 0),
                file_id: ($m.document.file_id // ""),
                file_name: ($m.document.file_name // ""),
                mime_type: ($m.document.mime_type // ""),
                caption: ($m.caption // "")
              }
            | select(.file_id != "")
          ] | sort_by(.date,.update_id) | last // empty | @json
        ' 2>/dev/null
    }

    max_chat_update() {
        printf '%s' "$1" | jq -r --arg chat "$chatId" '
          [ .result[]? | select(.message?.chat?.id|tostring == $chat) | .update_id ]
          | max // empty
        ' 2>/dev/null
    }

    # Ambil update terakhir hanya sebagai titik awal. File yang dipakai harus
    # datang SETELAH titik ini, sehingga tidak salah mengambil file lama.
    echo "[2/8] Menunggu file backup baru..."
    TG_UPDATES="$(telegram_get_updates)"
    if [ "$(printf '%s' "$TG_UPDATES" | jq -r '.ok // false' 2>/dev/null)" != "true" ]; then
        red "Telegram getUpdates gagal. Periksa BOT_TOKEN, CHAT_ID, internet, atau webhook."
        for svc in "${STOPPED_SERVICES[@]}"; do systemctl start "$svc" >/dev/null 2>&1 || true; done
        return 1
    fi

    BASELINE_ID="$(max_chat_update "$TG_UPDATES")"
    if [[ "$BASELINE_ID" =~ ^[0-9]+$ ]]; then
        NEXT_OFFSET=$((BASELINE_ID + 1))
    else
        NEXT_OFFSET=1
    fi

    echo
    yellow "=================================================="
    yellow " KIRIM FILE BACKUP SEKARANG KE BOT TELEGRAM"
    yellow "=================================================="
    echo "Chat ID yang dipantau : $chatId"
    echo "File harus berupa ZIP backup Marzban."
    echo "Menunggu maksimal ${WAIT_SECONDS} detik..."
    echo

    # Kirim instruksi ke chat agar jelas bahwa VPS sedang menunggu upload.
    curl -fsS --connect-timeout 10 --max-time 20 \
        -X POST "https://api.telegram.org/bot${botToken}/sendMessage" \
        --data-urlencode "chat_id=${chatId}" \
        --data-urlencode "text=Silakan kirim SEKARANG file backup ZIP Marzban ke bot ini. VPS sedang menunggu file secara otomatis." \
        >/dev/null 2>&1 || true

    local elapsed=0
    while [ "$elapsed" -lt "$WAIT_SECONDS" ]; do
        TG_UPDATES="$(telegram_get_updates "$NEXT_OFFSET")"
        if [ "$(printf '%s' "$TG_UPDATES" | jq -r '.ok // false' 2>/dev/null)" = "true" ]; then
            FOUND_JSON="$(find_document_in_updates "$TG_UPDATES")"
            if [ -n "$FOUND_JSON" ] && [ "$FOUND_JSON" != "null" ]; then
                FILE_ID="$(printf '%s' "$FOUND_JSON" | jq -r '.file_id')"
                FILE_NAME="$(printf '%s' "$FOUND_JSON" | jq -r '.file_name')"
                LAST_UPDATE_ID="$(printf '%s' "$FOUND_JSON" | jq -r '.update_id')"
                break
            fi

            local maxid
            maxid="$(max_chat_update "$TG_UPDATES")"
            if [[ "$maxid" =~ ^[0-9]+$ ]]; then
                NEXT_OFFSET=$((maxid + 1))
            fi
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done

    if [ -z "$FILE_ID" ]; then
        red "File backup baru tidak ditemukan setelah ${WAIT_SECONDS} detik."
        echo "Pastikan file dikirim ke chat yang sama dengan CHAT_ID di konfigurasi."
        for svc in "${STOPPED_SERVICES[@]}"; do systemctl start "$svc" >/dev/null 2>&1 || true; done
        return 1
    fi

    green "[✓] File baru terdeteksi: ${FILE_NAME:-backup.zip}"
    echo "[3/8] Mengambil file_path dari Telegram..."

    GETFILE_JSON="$(curl -fsS --connect-timeout 15 --max-time 30 \
        --get --data-urlencode "file_id=$FILE_ID" \
        "https://api.telegram.org/bot${botToken}/getFile" 2>/dev/null || true)"
    OK="$(printf '%s' "$GETFILE_JSON" | jq -r '.ok // false' 2>/dev/null)"
    FILE_PATH="$(printf '%s' "$GETFILE_JSON" | jq -r '.result.file_path // empty' 2>/dev/null)"
    if [ "$OK" != "true" ] || [ -z "$FILE_PATH" ]; then
        red "Telegram tidak dapat memberikan file_path untuk file tersebut."
        for svc in "${STOPPED_SERVICES[@]}"; do systemctl start "$svc" >/dev/null 2>&1 || true; done
        return 1
    fi

    TMP_DIR="$(mktemp -d /root/mummy-restore.XXXXXX)"
    ZIP_FILE="$TMP_DIR/backup.zip"
    SAFETY_DIR="/root/mummy-restore-safety-$(date +%Y%m%d-%H%M%S)"
    cleanup_restore() {
        rm -rf "$TMP_DIR"
        for svc in "${STOPPED_SERVICES[@]}"; do systemctl start "$svc" >/dev/null 2>&1 || true; done
    }
    trap cleanup_restore RETURN

    echo "[4/8] Mengunduh file backup..."
    if ! curl -fL --connect-timeout 15 --max-time 900 \
        "https://api.telegram.org/file/bot${botToken}/${FILE_PATH}" -o "$ZIP_FILE"; then
        red "Gagal mengunduh file dari Telegram."
        return 1
    fi
    [ -s "$ZIP_FILE" ] || { red "File backup kosong."; return 1; }

    echo "[5/8] Memeriksa dan mengekstrak backup..."
    unzip -t "$ZIP_FILE" >/dev/null 2>&1 || { red "File yang dikirim bukan ZIP backup yang valid."; return 1; }
    mkdir -p "$TMP_DIR/extract"
    unzip -q "$ZIP_FILE" -d "$TMP_DIR/extract" || { red "Gagal mengekstrak backup."; return 1; }

    DB_FILE="$(find "$TMP_DIR/extract" -type f -name 'db.sqlite3' -print -quit 2>/dev/null)"
    [ -n "$DB_FILE" ] || { red "db.sqlite3 tidak ditemukan di dalam backup."; return 1; }
    sqlite3 "$DB_FILE" 'PRAGMA integrity_check;' 2>/dev/null | grep -qx 'ok' || { red "Database backup rusak/tidak valid."; return 1; }

    echo "[6/8] Menghentikan Marzban dan memulihkan data..."
    mkdir -p "$SAFETY_DIR"
    cp -a /var/lib/marzban "$SAFETY_DIR/marzban-live" 2>/dev/null || true

    if [ -f /opt/marzban/docker-compose.yml ] || [ -f /opt/marzban/compose.yml ]; then
        COMPOSE_DIR=/opt/marzban
    else
        red "Compose Marzban tidak ditemukan."
        return 1
    fi
    cd "$COMPOSE_DIR" || return 1

    if docker compose version >/dev/null 2>&1; then
        docker compose stop marzban >/dev/null 2>&1 || true
    elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose stop marzban >/dev/null 2>&1 || true
    else
        red "Docker Compose tidak tersedia."
        return 1
    fi

    mkdir -p /var/lib/marzban
    cp -f "$DB_FILE" /var/lib/marzban/db.sqlite3

    local item src
    for item in xray_config.json max_ips.conf xray.crt xray.key; do
        src="$(find "$TMP_DIR/extract" -type f -name "$item" -print -quit 2>/dev/null)"
        [ -n "$src" ] && cp -f "$src" "/var/lib/marzban/$item"
    done
    [ -f /var/lib/marzban/xray.crt ] && chmod 644 /var/lib/marzban/xray.crt || true
    [ -f /var/lib/marzban/xray.key ] && chmod 600 /var/lib/marzban/xray.key || true

    echo "[7/8] Menjalankan kembali Marzban..."
    if docker compose version >/dev/null 2>&1; then docker compose up -d; else docker-compose up -d; fi
    sleep 8

    CONTAINER_NAMES="$(docker ps --format '{{.Names}}' | grep -Ei '(^|[-_])marzban($|[-_])' || true)"
    if [ -z "$CONTAINER_NAMES" ]; then
        red "Container Marzban belum aktif setelah restore."
        echo "Safety backup: $SAFETY_DIR"
        return 1
    fi
    sqlite3 /var/lib/marzban/db.sqlite3 'PRAGMA integrity_check;' 2>/dev/null | grep -qx 'ok' || {
        red "Database hasil restore gagal integrity_check."
        echo "Safety backup: $SAFETY_DIR"
        return 1
    }

    {
        printf '### auto-restore %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'File ID: %s\n' "$FILE_ID"
        printf 'File Name: %s\n' "${FILE_NAME:-backup.zip}"
    } >> "$FILE_ID_FILE"

    if [[ "$LAST_UPDATE_ID" =~ ^[0-9]+$ ]]; then
        curl -fsS --connect-timeout 10 --max-time 20 \
            "https://api.telegram.org/bot${botToken}/getUpdates?offset=$((LAST_UPDATE_ID+1))&limit=1" \
            >/dev/null 2>&1 || true
    fi

    rm -rf "$SAFETY_DIR"
    echo
    green "=================================================="
    green " RESTORE OTOMATIS VPS BARU BERHASIL"
    green " File Telegram terdeteksi dan dipulihkan."
    green "=================================================="
    command -v profile >/dev/null 2>&1 && profile || true
}

case "${1:-}" in
    daily|weekly|monthly)
        backup_and_send_telegram
        exit $?
        ;;
esac

while :; do
    print_header
    echo "Main Menu:"
    echo "1. Backup and Send to Telegram"
    echo "2. Set Backup Timer"
    echo "3. Remove Backup Timer"
    echo "4. Restore Otomatis dari Telegram"
    echo "5. Exit"
    read -r -p "Enter your choice (1-5): " choice

    case "$choice" in
        1) backup_and_send_telegram ;;
        2) set_backup_timer ;;
        3) remove_backup_timer ;;
        4) restore_from_telegram ;;
        5) exit 0 ;;
        *) red "Invalid choice. Try again." ;;
    esac
done
