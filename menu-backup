#!/bin/bash
set -u

# ============================================================
# MUMMY - Backup & Restore Menu
# ============================================================

DATA_DIR="/etc/data"
CONFIG_FILE="${DATA_DIR}/telegram_config.conf"
# SINGLE SOURCE OF TRUTH: BWBOT reads botToken/chatId from this file.
NAME_FILE="${DATA_DIR}/nama"
FILE_ID_FILE="${DATA_DIR}/file_id.txt"
LOG_FILE="${DATA_DIR}/log-backup.txt"
BACKUP_DIR="/root/backup"

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Skrip ini harus dijalankan sebagai root."
    exit 1
fi

mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"

green() { printf '\033[32;1m%s\033[0m\n' "$*"; }
red()   { printf '\033[31;1m%s\033[0m\n' "$*"; }

print_header() {
    clear
    echo "**************************************************"
    echo "*                                                *"
    echo "*       Backup and Restore Options Menu          *"
    echo "*                                                *"
    echo "**************************************************"
    echo
}

save_telegram_config() {
    local bot chat
    read -r -p "Enter your Telegram bot token: " bot
    read -r -p "Enter your Telegram user ID: " chat

    if [ -z "$bot" ] || [ -z "$chat" ]; then
        red "Bot token dan user ID tidak boleh kosong."
        return 1
    fi

    umask 077
    {
        printf 'botToken=%q\n' "$bot"
        printf 'chatId=%q\n' "$chat"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    green "Konfigurasi Telegram berhasil disimpan."
}

load_telegram_config() {
    if [ ! -s "$CONFIG_FILE" ]; then
        echo "Konfigurasi Telegram belum tersedia."
        save_telegram_config || return 1
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    if [ -z "${botToken:-}" ] || [ -z "${chatId:-}" ]; then
        red "Konfigurasi Telegram tidak valid."
        return 1
    fi
}

get_server_name() {
    local n="server"
    if [ -s "$NAME_FILE" ]; then
        n="$(tr -d '\r\n' < "$NAME_FILE")"
    fi
    n="${n//[^a-zA-Z0-9._-]/_}"
    [ -n "$n" ] || n="server"
    printf '%s' "$n"
}

get_public_ip() {
    local ip
    ip="$(curl -4fsS --connect-timeout 8 --max-time 15 https://api.ipify.org 2>/dev/null || true)"
    [ -n "$ip" ] && printf '%s' "$ip" || printf 'Unknown'
}

html_escape() {
    local v="$1"
    v="${v//&/&amp;}"
    v="${v//</&lt;}"
    v="${v//>/&gt;}"
    v="${v//\"/&quot;}"
    printf '%s' "$v"
}

check_requirements() {
    local missing=()
    for cmd in curl jq zip unzip docker crontab; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        red "Command belum tersedia: ${missing[*]}"
        return 1
    fi
}

backup_and_send_telegram() {
    print_header

    load_telegram_config || return 1

    check_requirements || return 1

    local nama tanggal tanggal2 waktu curdir response ok file_id
    local IP_ADDRESS CLIENT_NAME_ESCAPED IP_ADDRESS_ESCAPED CAPTION
    nama="$(get_server_name)"
    tanggal="$(date '+%m-%d-%Y')"
    tanggal2="$(date '+%m%d%Y')"
    waktu="$(date '+%H%M%S')"

    if [ ! -d /opt/marzban ] || [ ! -f /var/lib/marzban/db.sqlite3 ]; then
        red "Data Marzban tidak lengkap. Backup dibatalkan."
        return 1
    fi

    rm -rf "$BACKUP_DIR"
    mkdir -p "$BACKUP_DIR"

    echo "Memulai Backup..."
    cp -a /opt/marzban "$BACKUP_DIR/" || { red "Gagal backup /opt/marzban."; rm -rf "$BACKUP_DIR"; return 1; }
    cp -a /var/lib/marzban/db.sqlite3 "$BACKUP_DIR/" || { red "Gagal backup database."; rm -rf "$BACKUP_DIR"; return 1; }

    for item in \
        /var/lib/marzban/xray_config.json \
        /var/lib/marzban/max_ips.conf \
        /var/www/html \
        "$CONFIG_FILE" \
        "$FILE_ID_FILE"
    do
        [ -e "$item" ] && cp -a "$item" "$BACKUP_DIR/" || true
    done

    curdir="/root/${nama}_${waktu}_${tanggal2}.zip"
    rm -f "$curdir"

    if ! (cd /root && zip -r -q "$(basename "$curdir")" "$(basename "$BACKUP_DIR")"); then
        red "Gagal membuat file ZIP."
        rm -rf "$BACKUP_DIR"
        return 1
    fi

    # Informasi yang ditampilkan pada caption Telegram.
    IP_ADDRESS="$(get_public_ip)"
    CLIENT_NAME="$nama"

    # Escape HTML agar nama client/IP tidak merusak parse_mode=HTML.
    CLIENT_NAME_ESCAPED="$(html_escape "$CLIENT_NAME")"
    IP_ADDRESS_ESCAPED="$(html_escape "$IP_ADDRESS")"

    CAPTION="$(printf '%s\n' \
        '=================================' \
        '『 Successfully backup your Database 』' \
        '=================================' \
        "◈ Client  : <code>${CLIENT_NAME_ESCAPED}</code>" \
        "◈ IP VPS  : <code>${IP_ADDRESS_ESCAPED}</code>" \
        '◈ Version  : 3.1 Stable' \
        '◈ Built By  : @Faiqzuhry' \
        '=================================')"

    echo "Mengirim file backup ke bot Telegram..."

    response="$(
        curl -fsS --connect-timeout 15 --max-time 600 \
            -F "chat_id=${chatId}" \
            -F "document=@${curdir}" \
            -F "caption=${CAPTION}" \
            -F "parse_mode=HTML" \
            "https://api.telegram.org/bot${botToken}/sendDocument" 2>/dev/null
    )"
    local curl_status=$?

    ok="$(printf '%s' "$response" | jq -r '.ok // false' 2>/dev/null)"
    file_id="$(printf '%s' "$response" | jq -r '.result.document.file_id // empty' 2>/dev/null)"

    if [ "$curl_status" -ne 0 ] || [ "$ok" != "true" ] || [ -z "$file_id" ]; then
        red "Gagal mengirim backup ke Telegram."
        [ -n "$response" ] && printf '%s\n' "$response"
        red "File backup tetap disimpan di: $curdir"
        rm -rf "$BACKUP_DIR"
        return 1
    fi

    {
        printf '### %s_%s_%s\n' "$nama" "$waktu" "$tanggal"
        printf 'File ID: %s\n' "$file_id"
        printf 'Server telah berhasil backup data pada tanggal %s pukul %s.\n' "$tanggal" "$waktu"
    } >> "$FILE_ID_FILE"

    printf '%s - Backup berhasil dikirim: %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$curdir" >> "$LOG_FILE"

    rm -rf "$BACKUP_DIR"
    rm -f "$curdir"

    green "Backup berhasil dibuat dan dikirim ke Telegram."
    echo "File ID: $file_id"

    command -v profile >/dev/null 2>&1 && profile || true
}

set_backup_timer() {
    print_header
    echo "1. Set Daily Backup Timer"
    echo "2. Set Weekly Backup Timer"
    echo "3. Set Monthly Backup Timer"
    echo "4. Back to Main Menu"
    read -r -p "Enter your choice (1-4): " choice

    local t h m d
    case "$choice" in
        1)
            read -r -p "Daily time (HH:MM): " t
            if [[ ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Format waktu salah."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup daily'; echo "$m $h * * * /usr/bin/backup daily") | crontab -
            ;;
        2)
            read -r -p "Day (0-6, Sunday-Saturday): " d
            read -r -p "Weekly time (HH:MM): " t
            if [[ ! "$d" =~ ^[0-6]$ || ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Input tidak valid."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup weekly'; echo "$m $h * * $d /usr/bin/backup weekly") | crontab -
            ;;
        3)
            read -r -p "Day of month (1-31): " d
            read -r -p "Monthly time (HH:MM): " t
            if [[ ! "$d" =~ ^([1-9]|[12][0-9]|3[01])$ || ! "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then red "Input tidak valid."; return 1; fi
            h="${t%:*}"; m="${t#*:}"
            (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup monthly'; echo "$m $h $d * * /usr/bin/backup monthly") | crontab -
            ;;
        4) return 0 ;;
        *) red "Pilihan tidak valid."; return 1 ;;
    esac

    green "Backup timer berhasil disimpan."
}

remove_backup_timer() {
    print_header
    echo "1. Remove Daily Backup Timer"
    echo "2. Remove Weekly Backup Timer"
    echo "3. Remove Monthly Backup Timer"
    echo "4. Back to Main Menu"
    read -r -p "Enter your choice (1-4): " choice

    case "$choice" in
        1) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup daily') | crontab - ;;
        2) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup weekly') | crontab - ;;
        3) (crontab -l 2>/dev/null | grep -vF '/usr/bin/backup monthly') | crontab - ;;
        4) return 0 ;;
        *) red "Pilihan tidak valid."; return 1 ;;
    esac
    green "Backup timer berhasil dihapus."
}

restore_from_telegram() {
    print_header
    load_telegram_config || return 1

    # Restore tanpa input File ID dan tanpa password.
    # Hanya memeriksa MAKSIMAL 5 update Telegram terbaru yang tersedia.
    local TMP_DIR ZIP_FILE FILE_ID FILE_PATH TG_RESPONSE UPDATE_JSON
    local SAFETY_DIR COMPOSE_DIR CONTAINER_NAMES DB_FILE FOUND
    local SELECTED_NAME SELECTED_DATE UPDATE_ID
    local COUNT choice i UDATE UDATE_EPOCH UFID UNAME DATE_TEXT
    local API_BASE="https://api.telegram.org/bot${botToken}"

    for cmd in curl jq unzip docker; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            red "Command belum tersedia: $cmd"
            return 1
        fi
    done

    TMP_DIR="$(mktemp -d /root/mummy-restore.XXXXXX)"
    SAFETY_DIR="/root/mummy-restore-safety-$(date +%Y%m%d-%H%M%S)"

    echo "=== RESTORE BACKUP DARI TELEGRAM ==="
    echo
    echo "Tidak perlu memasukkan File ID."
    echo "Tidak perlu memasukkan password."
    echo
    echo "Maksimal 5 update Telegram terakhir akan diperiksa."
    echo "Kirim / forward backup ZIP ke chat Telegram bot."
    echo

    # getUpdates tidak dapat berjalan bersamaan dengan webhook/poller lain.
    # Cek webhook lebih dahulu agar pesan error tidak tampak seperti hang.
    local WEBHOOK_JSON WEBHOOK_URL API_ERROR
    WEBHOOK_JSON="$(curl -4 -fsS --connect-timeout 10 --max-time 15 \
        "${API_BASE}/getWebhookInfo" 2>/dev/null || true)"
    if [ -n "$WEBHOOK_JSON" ]; then
        WEBHOOK_URL="$(printf '%s' "$WEBHOOK_JSON" | jq -r '.result.url // empty' 2>/dev/null || true)"
        if [ -n "$WEBHOOK_URL" ]; then
            red "Bot Telegram sedang menggunakan WEBHOOK."
            echo "Restore otomatis tidak bisa membaca getUpdates selama webhook aktif."
            echo "Webhook: $WEBHOOK_URL"
            echo
            echo "Jangan hapus webhook jika bot utama Anda membutuhkannya."
            echo "Restore dibatalkan agar bot utama tidak terganggu."
            return 1
        fi
    fi

    # PENTING: Bot Telegram lain di VPS dapat memakai token yang sama untuk
    # getUpdates. Kalau polling lain tetap hidup, restore tidak pernah melihat
    # file yang baru di-forward. Karena user sedang menjalankan restore dari
    # terminal, hentikan sementara service polling yang umum dipakai.
    local RESTART_VPS_MENU=0 RESTART_USAGE=0
    if systemctl is-active --quiet telegram-vps-menu.service 2>/dev/null; then
        RESTART_VPS_MENU=1
        echo "Menghentikan sementara telegram-vps-menu.service..."
        systemctl stop telegram-vps-menu.service 2>/dev/null || true
    fi
    if systemctl is-active --quiet check-usage.service 2>/dev/null; then
        RESTART_USAGE=1
        echo "Menghentikan sementara check-usage.service..."
        systemctl stop check-usage.service 2>/dev/null || true
    fi
    if systemctl is-active --quiet bot-usage.service 2>/dev/null; then
        RESTART_USAGE=1
        echo "Menghentikan sementara bot-usage.service..."
        systemctl stop bot-usage.service 2>/dev/null || true
    fi

    restart_pollers() {
        if [ "$RESTART_USAGE" -eq 1 ]; then
            if systemctl list-unit-files --type=service 2>/dev/null | grep -q '^check-usage.service'; then
                systemctl start check-usage.service 2>/dev/null || true
            elif systemctl list-unit-files --type=service 2>/dev/null | grep -q '^bot-usage.service'; then
                systemctl start bot-usage.service 2>/dev/null || true
            fi
        fi
        [ "$RESTART_VPS_MENU" -eq 1 ] && systemctl start telegram-vps-menu.service 2>/dev/null || true
    }
    trap 'restart_pollers; rm -rf "$TMP_DIR"' RETURN

    echo
    echo "Mengambil 5 update Telegram terakhir..."
    echo "Kirim / forward file backup ZIP SEKARANG ke chat bot."
    echo "Polling bot dihentikan sementara agar file pasti terbaca oleh restore."

    # Beri waktu singkat agar service benar-benar berhenti dan Telegram siap.
    sleep 1

    # Jangan memakai offset=-5 berulang kali. Pada beberapa kondisi Telegram,
    # pola tersebut dapat mengembalikan antrean yang sama atau tidak menangkap
    # update baru seperti yang diharapkan. Kita buang update lama sekali,
    # lalu polling update BARU dari offset yang benar.
    UPDATE_JSON=""
    local NEXT_OFFSET=""
    local attempt=0

    # Flush antrean lama. Jika ada update lama, Telegram mengembalikan update
    # terakhir; kita mulai polling setelah update tersebut.
    local FLUSH_JSON FLUSH_LAST
    FLUSH_JSON="$(curl -4 -fsS --connect-timeout 8 --max-time 15 \
        --get \
        --data-urlencode "offset=-1" \
        --data-urlencode "limit=1" \
        --data-urlencode "timeout=0" \
        "${API_BASE}/getUpdates" 2>/dev/null || true)"

    if [ -n "$FLUSH_JSON" ] && [ "$(printf '%s' "$FLUSH_JSON" | jq -r '.ok // false' 2>/dev/null)" = "true" ]; then
        FLUSH_LAST="$(printf '%s' "$FLUSH_JSON" | jq -r '.result[-1].update_id // empty' 2>/dev/null || true)"
        if [[ "$FLUSH_LAST" =~ ^[0-9]+$ ]]; then
            NEXT_OFFSET=$((FLUSH_LAST + 1))
        fi
    else
        API_ERROR="$(printf '%s' "$FLUSH_JSON" | jq -r '.description // empty' 2>/dev/null || true)"
        if printf '%s' "$API_ERROR" | grep -qi 'webhook'; then
            red "Telegram masih menggunakan WEBHOOK; getUpdates tidak tersedia."
            restart_pollers
            return 1
        fi
    fi

    echo "Menunggu file ZIP baru dari Telegram..."

    # Tunggu maksimal 60 detik. Satu file saja sudah cukup; maksimal 5 ZIP
    # terbaru dari update baru akan ditampilkan.
    while [ "$attempt" -lt 30 ]; do
        attempt=$((attempt + 1))

        if [ -n "$NEXT_OFFSET" ]; then
            UPDATE_JSON="$(curl -4 -fsS --connect-timeout 8 --max-time 15 \
                --get \
                --data-urlencode "offset=${NEXT_OFFSET}" \
                --data-urlencode "limit=5" \
                --data-urlencode "timeout=2" \
                "${API_BASE}/getUpdates" 2>/dev/null || true)"
        else
            UPDATE_JSON="$(curl -4 -fsS --connect-timeout 8 --max-time 15 \
                --get \
                --data-urlencode "limit=5" \
                --data-urlencode "timeout=2" \
                "${API_BASE}/getUpdates" 2>/dev/null || true)"
        fi

        if [ -n "$UPDATE_JSON" ] && [ "$(printf '%s' "$UPDATE_JSON" | jq -r '.ok // false' 2>/dev/null)" = "true" ]; then
            # Simpan offset sesudah batch ini supaya batch yang sama tidak
            # dibaca ulang pada percobaan berikutnya.
            local BATCH_LAST
            BATCH_LAST="$(printf '%s' "$UPDATE_JSON" | jq -r '.result[-1].update_id // empty' 2>/dev/null || true)"
            if [[ "$BATCH_LAST" =~ ^[0-9]+$ ]]; then
                NEXT_OFFSET=$((BATCH_LAST + 1))
            fi

            if printf '%s' "$UPDATE_JSON" | jq -e --arg chat "$chatId" '
                any(.result[]?;
                    (((.message.chat.id|tostring) == $chat or (.channel_post.chat.id|tostring) == $chat)) and
                    ((.message.document.file_id // .channel_post.document.file_id) != null) and
                    (((.message.document.file_name // .channel_post.document.file_name // "") | ascii_downcase | endswith(".zip")))
                )' >/dev/null 2>&1; then
                break
            fi
        fi

        API_ERROR="$(printf '%s' "$UPDATE_JSON" | jq -r '.description // empty' 2>/dev/null || true)"
        if printf '%s' "$API_ERROR" | grep -qi 'webhook'; then
            red "Telegram masih menggunakan WEBHOOK; getUpdates tidak tersedia."
            restart_pollers
            return 1
        fi
        sleep 1
    done

    if [ -z "$UPDATE_JSON" ] || [ "$(printf '%s' "$UPDATE_JSON" | jq -r '.ok // false' 2>/dev/null)" != "true" ]; then
        red "Gagal mengambil update dari Telegram."
        API_ERROR="$(printf '%s' "$UPDATE_JSON" | jq -r '.description // empty' 2>/dev/null || true)"
        [ -n "$API_ERROR" ] && echo "Telegram: $API_ERROR"
        return 1
    fi

    # Dari MAKSIMAL 5 update yang diterima, hanya document ZIP dari chatId
    # yang dipakai. Terbaru ditampilkan sebagai nomor 1.
    COUNT="$({
        printf '%s' "$UPDATE_JSON" |
        jq -r --arg chat "$chatId" '
            [.result[] |
             select(
                ((.message.chat.id|tostring) == $chat or
                 (.channel_post.chat.id|tostring) == $chat)
             ) |
             {
               update_id: .update_id,
               date: (.message.date // .channel_post.date // 0),
               document: (.message.document // .channel_post.document)
             } |
             select(.document.file_id != null) |
             select(((.document.file_name // "") | ascii_downcase | endswith(".zip")))
            ] |
            sort_by(.date) |
            reverse |
            .[] |
            [.update_id, .date, .document.file_id, (.document.file_name // "backup.zip")] |
            @tsv
        '
    } | tee "$TMP_DIR/backup_list.tsv" | wc -l)"

    if [ "$COUNT" -eq 0 ]; then
        red "Tidak ada backup ZIP pada 5 update Telegram terakhir."
        echo "Pastikan file ZIP benar-benar dikirim/forward ke chatId: $chatId"
        echo "Lalu jalankan Restore lagi."
        return 1
    fi

    echo
    green "Backup ditemukan:"
    echo

    i=0
    while IFS=$'\t' read -r UDATE UDATE_EPOCH UFID UNAME; do
        i=$((i + 1))
        DATE_TEXT="$(date -d "@${UDATE_EPOCH}" '+%d-%m-%Y %H:%M:%S' 2>/dev/null || printf '%s' "$UDATE_EPOCH")"
        printf '[%d] %s\n' "$i" "$UNAME"
        printf '    %s\n' "$DATE_TEXT"
        echo
    done < "$TMP_DIR/backup_list.tsv"

    while :; do
        read -r -p "Pilih backup [1-${COUNT}] (0=batal): " choice
        if [ "$choice" = "0" ]; then
            echo "Restore dibatalkan."
            return 0
        fi
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$COUNT" ]; then
            break
        fi
        red "Pilihan tidak valid."
    done

    IFS=$'\t' read -r UPDATE_ID SELECTED_DATE FILE_ID SELECTED_NAME < <(sed -n "${choice}p" "$TMP_DIR/backup_list.tsv")
    ZIP_FILE="$TMP_DIR/backup.zip"

    echo
    echo "Backup dipilih: $SELECTED_NAME"
    echo "[1/8] Mengambil informasi file dari Telegram..."

    TG_RESPONSE="$(curl -4 -fsS --connect-timeout 15 --max-time 60 \
        --get --data-urlencode "file_id=${FILE_ID}" \
        "${API_BASE}/getFile" 2>/dev/null || true)"

    if [ "$(printf '%s' "$TG_RESPONSE" | jq -r '.ok // false' 2>/dev/null)" != "true" ]; then
        red "Telegram tidak dapat mengambil file backup."
        echo "File ID didapat otomatis dari update Telegram."
        return 1
    fi

    FILE_PATH="$(printf '%s' "$TG_RESPONSE" | jq -r '.result.file_path // empty' 2>/dev/null)"
    [ -n "$FILE_PATH" ] || { red "File path Telegram tidak ditemukan."; return 1; }

    echo "[2/8] Mengunduh backup (tanpa password)..."
    if ! curl -4 -fsS --connect-timeout 15 --max-time 900 \
        -o "$ZIP_FILE" \
        "https://api.telegram.org/file/bot${botToken}/${FILE_PATH}"; then
        red "Gagal mengunduh backup dari Telegram."
        return 1
    fi

    [ -s "$ZIP_FILE" ] || { red "File backup kosong."; return 1; }

    echo "[3/8] Memeriksa dan mengekstrak ZIP tanpa password..."
    if ! unzip -t -q "$ZIP_FILE" >/dev/null 2>&1; then
        red "File backup bukan ZIP valid atau rusak."
        return 1
    fi

    mkdir -p "$TMP_DIR/extracted"
    if ! unzip -q "$ZIP_FILE" -d "$TMP_DIR/extracted"; then
        red "Gagal mengekstrak backup."
        return 1
    fi

    DB_FILE="$(find "$TMP_DIR/extracted" -type f -name 'db.sqlite3' -print -quit)"
    if [ -z "$DB_FILE" ] || [ ! -f "$DB_FILE" ]; then
        red "db.sqlite3 tidak ditemukan di dalam backup."
        return 1
    fi

    echo "[4/8] Membuat safety backup database VPS baru..."
    mkdir -p "$SAFETY_DIR"
    if [ -f /var/lib/marzban/db.sqlite3 ]; then
        cp -a /var/lib/marzban/db.sqlite3 "$SAFETY_DIR/db.sqlite3" || {
            red "Gagal membuat safety backup database."
            rm -rf "$SAFETY_DIR"
            return 1
        }
    fi

    COMPOSE_DIR=""
    if [ -d /opt/marzban ]; then
        if [ -f /opt/marzban/docker-compose.yml ] || [ -f /opt/marzban/compose.yml ]; then
            COMPOSE_DIR="/opt/marzban"
        fi
    fi

    if [ -n "$COMPOSE_DIR" ]; then
        echo "[5/8] Menghentikan Marzban sementara..."
        (
            cd "$COMPOSE_DIR" &&
            docker compose stop marzban 2>/dev/null || docker compose stop 2>/dev/null
        ) || true
    else
        red "Directory Docker Compose Marzban tidak ditemukan di /opt/marzban."
        red "Restore dibatalkan sebelum database diganti."
        return 1
    fi

    mkdir -p /var/lib/marzban
    echo "[6/8] Restore database Marzban..."
    if ! cp -a "$DB_FILE" /var/lib/marzban/db.sqlite3; then
        red "Gagal mengembalikan db.sqlite3."
        return 1
    fi
    chmod 600 /var/lib/marzban/db.sqlite3 2>/dev/null || true

    for file in xray_config.json max_ips.conf; do
        FOUND="$(find "$TMP_DIR/extracted" -type f -name "$file" -print -quit)"
        if [ -n "$FOUND" ]; then
            cp -a "$FOUND" "/var/lib/marzban/$file" || {
                red "Gagal mengembalikan $file."
                return 1
            }
        fi
    done

    echo "[7/8] Menjalankan Marzban kembali..."
    (
        cd "$COMPOSE_DIR" && docker compose up -d
    ) || {
        red "Marzban gagal dijalankan setelah restore."
        red "Safety backup tersimpan di: $SAFETY_DIR"
        return 1
    }

    sleep 5

    echo "[8/8] Verifikasi service dan database..."
    CONTAINER_NAMES="$(
        docker ps --format '{{.Names}}' 2>/dev/null |
        grep -Ei '(^|[-_])marzban($|[-_])' || true
    )"

    if [ -z "$CONTAINER_NAMES" ]; then
        red "Database sudah direstore, tetapi container Marzban belum aktif."
        red "Safety backup tersimpan di: $SAFETY_DIR"
        return 1
    fi

    if command -v sqlite3 >/dev/null 2>&1; then
        if ! sqlite3 /var/lib/marzban/db.sqlite3 "PRAGMA integrity_check;" 2>/dev/null | grep -qx 'ok'; then
            red "PERINGATAN: integrity_check database tidak dapat dikonfirmasi."
            red "Safety backup tersimpan di: $SAFETY_DIR"
            return 1
        fi
    fi

    rm -rf "$SAFETY_DIR"

    green "=============================================="
    green " RESTORE VPS LAMA BERHASIL"
    green " Backup: $SELECTED_NAME"
    green " Database Marzban sudah dipindahkan ke VPS baru."
    green "=============================================="

    command -v profile >/dev/null 2>&1 && profile || true
}

# Support cron calls without opening the interactive menu.
case "${1:-}" in
    daily|weekly|monthly)
        backup_and_send_telegram
        exit $?
        ;;
esac

while :; do
    print_header
    echo "Main Menu:"
    echo "1. Backup and Send to Telegram"
    echo "2. Set Backup Timer"
    echo "3. Remove Backup Timer"
    echo "4. Restore from Telegram"
    echo "5. Exit"
    read -r -p "Enter your choice (1-5): " choice

    case "$choice" in
        1) backup_and_send_telegram ;;
        2) set_backup_timer ;;
        3) remove_backup_timer ;;
        4) restore_from_telegram ;;
        5) exit 0 ;;
        *) red "Invalid choice. Try again." ;;
    esac
done
