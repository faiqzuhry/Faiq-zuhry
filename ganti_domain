#!/bin/bash

MARZBAN_DIR="/opt/marzban"
XRAY_CONF="/opt/marzban/xray.conf"
DEFAULT_CONF="/opt/marzban/default.conf"
CERT_FILE="/var/lib/marzban/xray.crt"
KEY_FILE="/var/lib/marzban/xray.key"
DOMAIN_FILE="/etc/data/domain"
BACKUP_ROOT="/opt/marzban/domain-backups"
CF_DOMAIN_PREFIX="cf."
CF_NGINX_CONF="/opt/marzban/cloudfront-nginx.conf"
CF_XRAY_SERVICE="xray-cloudfront.service"
CF_API_CONF="/etc/data/cloudflare_dns.conf"
CF_API_BASE="https://api.cloudflare.com/client/v4"
CF_TEMPORARY_DNS_ONLY=0


info() {
    echo -e "\033[1;36m[INFO]\033[0m $1"
}

ok() {
    echo -e "\033[1;32m[ OK ]\033[0m $1"
}

warn() {
    echo -e "\033[1;33m[WARN]\033[0m $1"
}

error() {
    echo -e "\033[1;31m[ERR ]\033[0m $1"
}

die() {
    error "$1"
    exit 1
}

# ============================================================
# CLOUDFLARE API — DOMAIN UTAMA + CF SAJA
# - @  -> IP VPS (DNS Only)
# - cf -> IP VPS (DNS Only selama proses ganti domain/SSL,
#        lalu Proxied setelah SSL selesai)
# - Wildcard/CNAME TIDAK dikelola oleh ganti_domain.
#   Record wildcard/CNAME yang sudah ada dibiarkan tetap.
# API Token membutuhkan Zone > DNS > Edit pada zone baru.
# Token disimpan lokal dengan permission 600.
# ============================================================

cf_json_ok() {
    printf '%s' "$1" | jq -e '.success == true' >/dev/null 2>&1
}

cf_api() {
    local method="$1" url="$2" data="${3:-}"
    if [ -n "$data" ]; then
        curl -fsS --max-time 20 -X "$method" "$url" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" \
            --data "$data"
    else
        curl -fsS --max-time 20 -X "$method" "$url" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json"
    fi
}

load_cf_credentials() {
    mkdir -p /etc/data
    chmod 700 /etc/data

    if [ -f "$CF_API_CONF" ]; then
        # shellcheck disable=SC1090
        . "$CF_API_CONF"
    fi

    if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
        echo
        echo "Cloudflare API diperlukan untuk sinkronisasi @ dan cf."
        echo "Gunakan API Token dengan permission Zone > DNS > Edit."
        echo "Token akan disimpan di $CF_API_CONF (permission 600)."
        echo
        read -r -s -p "Cloudflare API Token: " CLOUDFLARE_API_TOKEN
        echo
        [ -n "$CLOUDFLARE_API_TOKEN" ] || die "Cloudflare API Token kosong."
    fi

    # ========================================================
    # ZONE ID — AUTO DETECT DENGAN FALLBACK MANUAL
    # ========================================================
    # Endpoint /zones memerlukan Zone > Zone > Read. Jika token hanya
    # mempunyai akses DNS pada zone tertentu, Cloudflare dapat mengembalikan
    # 403 walaupun token valid. Dalam kondisi itu, minta Zone ID manual.
    #
    # PENTING: jangan memakai CLOUDFLARE_ZONE_ID lama secara buta karena
    # NEW_DOMAIN dapat berada di zone yang berbeda.
    # ========================================================
    CLOUDFLARE_ZONE_ID=""
    info "Mendeteksi Zone ID Cloudflare untuk $NEW_DOMAIN..."

    local zone_json zone_http zone_success detected_zone
    zone_http=$(mktemp)
    zone_json=$(curl -sS --max-time 20 -w $'\n__HTTP_CODE__:%{http_code}' \
        -G "$CF_API_BASE/zones" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data-urlencode "name=$NEW_DOMAIN" \
        --data-urlencode "status=active" \
        --data-urlencode "per_page=1" 2>/dev/null || true)

    zone_http=$(printf '%s\n' "$zone_json" | sed -n 's/^__HTTP_CODE__://p' | tail -n1)
    zone_json=$(printf '%s\n' "$zone_json" | sed '/^__HTTP_CODE__:/d')
    detected_zone=$(printf '%s' "$zone_json" | jq -r '.result[0].id // empty' 2>/dev/null || true)
    zone_success=$(printf '%s' "$zone_json" | jq -r '.success // false' 2>/dev/null || true)

    if [ "$zone_success" = "true" ] && [ -n "$detected_zone" ]; then
        CLOUDFLARE_ZONE_ID="$detected_zone"
        ok "Zone ID otomatis ditemukan: $CLOUDFLARE_ZONE_ID"
    else
        echo
        warn "Auto-detect Zone ID gagal (HTTP ${zone_http:-unknown})."
        echo "Ini tidak selalu berarti API Token salah. Endpoint /zones membutuhkan"
        echo "permission Zone > Zone > Read. Jika token hanya memiliki akses DNS,"
        echo "masukkan Zone ID secara manual dari Cloudflare Dashboard."
        echo
        read -r -p "Cloudflare Zone ID untuk $NEW_DOMAIN: " CLOUDFLARE_ZONE_ID
        CLOUDFLARE_ZONE_ID=$(printf '%s' "$CLOUDFLARE_ZONE_ID" | tr -d '[:space:]')
        [ -n "$CLOUDFLARE_ZONE_ID" ] || die "Cloudflare Zone ID kosong."
    fi

    # ========================================================
    # JANGAN memanggil GET /zones/$ZONE_ID di sini.
    # Validasi tersebut juga membutuhkan Zone > Zone > Read dan merupakan
    # sumber 403 yang tidak diperlukan. DNS API berikutnya akan menjadi
    # validasi akses yang sebenarnya dibutuhkan oleh script.
    # ========================================================

    cat > "$CF_API_CONF" <<EOF
CLOUDFLARE_API_TOKEN='$CLOUDFLARE_API_TOKEN'
CLOUDFLARE_ZONE_ID='$CLOUDFLARE_ZONE_ID'
EOF
    chmod 600 "$CF_API_CONF"

    ok "Cloudflare Zone ID siap: $CLOUDFLARE_ZONE_ID"
}

cf_find_all_name() {
    local name="$1"
    curl -sS --max-time 20 -G \
        "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data-urlencode "name=$name" \
        --data-urlencode "per_page=100"
}

cf_upsert_a() {
    local name="$1" ip="$2" proxied="${3:-true}" records_json rid type old_id result body first_a=1
    records_json=$(cf_find_all_name "$name") || die "Gagal membaca DNS $name dari Cloudflare. Periksa permission DNS:Edit."
    cf_json_ok "$records_json" || die "Cloudflare menolak pembacaan DNS $name."

    # MODE A-ONLY: pastikan nama ini hanya memiliki satu A record.
    while IFS=$'\t' read -r type old_id; do
        [ -n "$old_id" ] || continue
        case "$type" in
            CNAME|AAAA)
                result=$(cf_api DELETE "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$old_id" 2>/dev/null || true)
                cf_json_ok "$result" || die "Gagal menghapus record konflik $type $name ($old_id)."
                ;;
            A)
                if [ "$first_a" = "1" ]; then
                    rid="$old_id"
                    first_a=0
                else
                    result=$(cf_api DELETE "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$old_id" 2>/dev/null || true)
                    cf_json_ok "$result" || die "Gagal menghapus duplikat A $name ($old_id)."
                fi
                ;;
        esac
    done < <(printf '%s' "$records_json" | jq -r '.result[] | [.type,.id] | @tsv')

    body=$(jq -nc --arg name "$name" --arg ip "$ip" --argjson proxied "$proxied" \
        '{type:"A",name:$name,content:$ip,ttl:1,proxied:$proxied}')

    if [ -n "$rid" ]; then
        result=$(cf_api PUT "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$rid" "$body") || \
            die "Gagal update A $name."
    else
        result=$(cf_api POST "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records" "$body") || \
            die "Gagal membuat A $name."
    fi
    cf_json_ok "$result" || die "Cloudflare menolak perubahan A $name."
    if [ "$proxied" = "true" ]; then
        ok "Cloudflare A $name → $ip 🟠 (Proxied)"
    else
        ok "Cloudflare A $name → $ip 🔘 (DNS Only)"
    fi
}


cloudflare_sync_dns() {
    load_cf_credentials

    # ganti_domain hanya mengelola 2 A record Cloudflare:
    #   @  -> PUBLIC_IP (DNS Only)
    #   cf -> PUBLIC_IP (DNS Only selama proses SSL)
    # Wildcard/CNAME yang sudah ada TIDAK dibuat, dipindahkan, dihapus,
    # atau diubah oleh script ini.
    local cf_backup_file="$BACKUP_ROOT/cloudflare-$NEW_DOMAIN-$(date +%Y%m%d-%H%M%S).json"
    mkdir -p "$BACKUP_ROOT"
    {
        printf '{"zone_id":"%s","zone_name":"%s","records":[' "$CLOUDFLARE_ZONE_ID" "$NEW_DOMAIN"
        cf_find_all_name "$NEW_DOMAIN" | jq -c '.result[]' 2>/dev/null | paste -sd, -
        printf '],"cf_records":['
        cf_find_all_name "$CF_DOMAIN" | jq -c '.result[]' 2>/dev/null | paste -sd, -
        printf ']}\n'
    } > "$cf_backup_file"
    chmod 600 "$cf_backup_file"
    ok "Backup DNS Cloudflare @ + cf: $cf_backup_file"

    info "Sinkronisasi DNS Cloudflare: hanya domain utama + CF..."
    echo "  @       → $PUBLIC_IP 🔘 (DNS Only)"
    echo "  cf      → $PUBLIC_IP 🔘 (DNS Only selama proses SSL)"
    echo "  wildcard/CNAME → TIDAK disentuh"
    echo

    # Domain utama @ tetap DNS Only.
    cf_upsert_a "$NEW_DOMAIN" "$PUBLIC_IP" "false"

    # cf wajib DNS Only selama proses ganti domain/SSL.
    cf_upsert_a "$CF_DOMAIN" "$PUBLIC_IP" "false"

    ok "DNS Cloudflare domain utama + CF sudah disinkronkan."
    ok "Wildcard/CNAME yang sudah ada tidak diubah."
}

if [ "$(id -u)" != "0" ]; then
    die "Jalankan sebagai root."
fi

[ -d "$MARZBAN_DIR" ] || die "$MARZBAN_DIR tidak ditemukan."
[ -f "$MARZBAN_DIR/docker-compose.yml" ] || die "docker-compose.yml tidak ditemukan."
command -v jq >/dev/null 2>&1 || die "jq tidak ditemukan. Install jq terlebih dahulu."

command -v docker >/dev/null 2>&1 || die "Docker tidak ditemukan."
docker compose version >/dev/null 2>&1 || die "Docker Compose tidak tersedia."
command -v curl >/dev/null 2>&1 || die "curl tidak ditemukan."

mkdir -p /etc/data "$BACKUP_ROOT"

clear 2>/dev/null

echo
echo "============================================================"
echo "              MARZBAN DOMAIN CHANGER"
echo "============================================================"
echo

# ============================================================
# DOMAIN LAMA
# ============================================================

CURRENT_DOMAIN=""

# Prioritas pertama: domain yang sebelumnya disimpan installer.
if [ -s "$DOMAIN_FILE" ]; then
    SAVED_DOMAIN=$(tr -d '[:space:]' < "$DOMAIN_FILE")

    if echo "$SAVED_DOMAIN" | grep -Eq \
        '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
        CURRENT_DOMAIN="$SAVED_DOMAIN"
    fi
fi

# Fallback: cari server_name domain valid dari konfigurasi.
if [ -z "$CURRENT_DOMAIN" ]; then
    for CONF in "$DEFAULT_CONF" "$XRAY_CONF" "$MARZBAN_DIR/nginx.conf"; do
        if [ -f "$CONF" ]; then
            FOUND=$(grep -Eo \
                'server_name[[:space:]]+[A-Za-z0-9.-]+\.[A-Za-z]{2,63}' \
                "$CONF" 2>/dev/null |
                head -n1 |
                awk '{print $2}')

            if echo "$FOUND" | grep -Eq \
                '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
                CURRENT_DOMAIN="$FOUND"
                break
            fi
        fi
    done
fi

echo "Domain saat ini:"
echo "  ${CURRENT_DOMAIN:-tidak ditemukan}"
echo

# ============================================================
# INPUT DOMAIN BARU
# ============================================================

read -r -p "Masukkan DOMAIN BARU: " NEW_DOMAIN

NEW_DOMAIN=$(printf '%s' "$NEW_DOMAIN" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[[:space:]]//g')

NEW_DOMAIN="${NEW_DOMAIN#http://}"
NEW_DOMAIN="${NEW_DOMAIN#https://}"
NEW_DOMAIN="${NEW_DOMAIN%%/*}"
NEW_DOMAIN="${NEW_DOMAIN%.}"

if ! echo "$NEW_DOMAIN" | grep -Eq \
    '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
    die "Format domain tidak valid: $NEW_DOMAIN"
fi

CF_DOMAIN="${CF_DOMAIN_PREFIX}${NEW_DOMAIN}"

# ============================================================
# PUBLIC IP
# ============================================================

info "Mendeteksi IP publik VPS..."

PUBLIC_IP=$(curl -4fsS --max-time 10 https://api.ipify.org 2>/dev/null)

[ -n "$PUBLIC_IP" ] || die "Gagal mendeteksi IP publik VPS."

echo "IP VPS : $PUBLIC_IP"
echo

# ============================================================
# CLOUDFLARE AUTO DNS
# ============================================================
# Dengan API aktif, script hanya mengelola @ dan cf.
# Wildcard/CNAME tidak dibuat, dipindahkan, dihapus, atau diubah.
# Proxy status: @ = DNS Only; cf = DNS Only saat SSL, lalu Proxied.
load_cf_credentials

# PRE-FLIGHT: pastikan token benar-benar boleh membaca DNS Records sebelum
# ada record yang diubah. Ini mencegah sinkronisasi setengah jalan akibat 403.
info "Memeriksa akses DNS Records Cloudflare..."
CF_PREFLIGHT=$(cf_find_all_name "$NEW_DOMAIN" 2>/dev/null || true)
if ! cf_json_ok "$CF_PREFLIGHT"; then
    echo
    error "Cloudflare menolak pembacaan DNS Records pada $NEW_DOMAIN."
    echo "Pastikan permission: Zone > DNS > Edit (DNS Write)."
    echo "Pastikan Zone Resources mencakup zone $NEW_DOMAIN."
    echo "Respons API:"
    printf '%s\n' "$CF_PREFLIGHT" | jq . 2>/dev/null || printf '%s\n' "$CF_PREFLIGHT"
    die "Pre-flight Cloudflare gagal. Tidak ada perubahan DNS yang dilakukan."
fi
ok "Akses DNS Records $NEW_DOMAIN: OK."

cloudflare_sync_dns
echo

# ============================================================
# DNS MAIN + CLOUDFRONT — CLOUDFLARE-AWARE
# ============================================================
# Jangan menilai DNS hanya dari hasil dig/getent.
# Jika record Cloudflare PROXIED (orange cloud), DNS publik memang
# mengembalikan IP edge Cloudflare, bukan IP origin VPS.
# Status authoritative diambil langsung dari Cloudflare API.
#
# Logika:
#   PROXIED + origin content == PUBLIC_IP  -> OK
#   DNS ONLY + content == PUBLIC_IP       -> OK
#   Public DNS == Cloudflare edge          -> normal bila PROXIED
#   selain itu                             -> warning/error
# ============================================================

resolve_a_all() {
    local d="$1"
    if command -v dig >/dev/null 2>&1; then
        dig +short A "$d" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
    elif command -v getent >/dev/null 2>&1; then
        getent ahostsv4 "$d" 2>/dev/null | awk '{print $1}' | sort -u
    else
        curl -4fsS --max-time 10 "https://dns.google/resolve?name=$d&type=A" 2>/dev/null |
            grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u
    fi
}

# Ambil A record authoritative langsung dari Cloudflare.
# Output: content<TAB>proxied<TAB>id
cf_get_a_status() {
    local name="$1" records
    records=$(cf_find_all_name "$name" 2>/dev/null || true)
    printf '%s' "$records" | jq -r '
        if .success != true then empty else
        .result[] | select(.type == "A") |
        [.content, (.proxied // false), .id] | @tsv
        end' 2>/dev/null | head -n1
}

# Public DNS Cloudflare edge bukan error.
is_cloudflare_ipv4() {
    local ip="$1" a b c d n
    IFS=. read -r a b c d <<< "$ip"
    [ -n "$d" ] || return 1
    n=$((a*16777216 + b*65536 + c*256 + d))

    local ranges=(
        "173.245.48.0/20" "103.21.244.0/22" "103.22.200.0/22"
        "103.31.4.0/22" "141.101.64.0/18" "108.162.192.0/18"
        "190.93.240.0/20" "188.114.96.0/20" "197.234.240.0/22"
        "198.41.128.0/17" "162.158.0.0/15" "104.16.0.0/13"
        "104.24.0.0/14" "172.64.0.0/13" "131.0.72.0/22"
    )

    local cidr base bits mask
    for cidr in "${ranges[@]}"; do
        base=${cidr%/*}
        bits=${cidr#*/}
        IFS=. read -r a b c d <<< "$base"
        base=$((a*16777216 + b*65536 + c*256 + d))
        mask=$(( (0xFFFFFFFF << (32-bits)) & 0xFFFFFFFF ))
        if (( (n & mask) == (base & mask) )); then
            return 0
        fi
    done
    return 1
}

info "Mengecek DNS domain utama + CloudFront melalui Cloudflare API..."

MAIN_STATUS=$(cf_get_a_status "$NEW_DOMAIN")
CF_STATUS=$(cf_get_a_status "$CF_DOMAIN")

MAIN_ORIGIN=$(printf '%s' "$MAIN_STATUS" | awk -F '\t' 'NR==1{print $1}')
MAIN_PROXY=$(printf '%s' "$MAIN_STATUS" | awk -F '\t' 'NR==1{print $2}')
MAIN_ID=$(printf '%s' "$MAIN_STATUS" | awk -F '\t' 'NR==1{print $3}')

CF_ORIGIN=$(printf '%s' "$CF_STATUS" | awk -F '\t' 'NR==1{print $1}')
CF_PROXY_STATUS=$(printf '%s' "$CF_STATUS" | awk -F '\t' 'NR==1{print $2}')
CF_ID=$(printf '%s' "$CF_STATUS" | awk -F '\t' 'NR==1{print $3}')

DNS_MAIN_LIST=$(resolve_a_all "$NEW_DOMAIN")
DNS_CF_LIST=$(resolve_a_all "$CF_DOMAIN")

echo "Domain utama : $NEW_DOMAIN"
echo "DNS publik  : ${DNS_MAIN_LIST:-tidak ditemukan}"
echo "Cloudflare  : ${MAIN_ORIGIN:-tidak ada A record} | Proxy: ${MAIN_PROXY:-unknown}"
echo "CloudFront  : $CF_DOMAIN"
echo "DNS publik  : ${DNS_CF_LIST:-tidak ditemukan}"
echo "Cloudflare  : ${CF_ORIGIN:-tidak ada A record} | Proxy: ${CF_PROXY_STATUS:-unknown}"
echo

DNS_OK=1

# ---------------- MAIN DOMAIN ----------------
if [ -z "$MAIN_STATUS" ]; then
    warn "A record $NEW_DOMAIN tidak ditemukan melalui Cloudflare API."
    DNS_OK=0
elif [ "$MAIN_ORIGIN" = "$PUBLIC_IP" ] && [ "$MAIN_PROXY" = "true" ]; then
    ok "Cloudflare A $NEW_DOMAIN → $PUBLIC_IP | PROXIED 🟠"
    echo "      DNS publik Cloudflare: ${DNS_MAIN_LIST:-belum terdeteksi}"
elif [ "$MAIN_ORIGIN" = "$PUBLIC_IP" ] && [ "$MAIN_PROXY" = "false" ]; then
    ok "Cloudflare A $NEW_DOMAIN → $PUBLIC_IP | DNS Only 🔘"
elif [ "$MAIN_ORIGIN" != "$PUBLIC_IP" ]; then
    warn "Origin A $NEW_DOMAIN = ${MAIN_ORIGIN:-tidak ada}, VPS = $PUBLIC_IP"
    DNS_OK=0
else
    warn "Status Proxy $NEW_DOMAIN tidak dapat ditentukan."
    DNS_OK=0
fi

# ---------------- CLOUDFRONT ----------------
CF_PROXY=0
CF_DIRECT=0

if [ -z "$CF_STATUS" ]; then
    warn "A record CloudFront $CF_DOMAIN tidak ditemukan melalui Cloudflare API."
    DNS_OK=0
elif [ "$CF_ORIGIN" = "$PUBLIC_IP" ] && [ "$CF_PROXY_STATUS" = "true" ]; then
    CF_PROXY=1
    ok "CloudFront ($CF_DOMAIN) = $PUBLIC_IP | PROXIED 🟠"
    echo "      DNS publik yang terlihat: ${DNS_CF_LIST:-belum terdeteksi}"
    echo "      Origin VPS yang tersimpan di Cloudflare: $CF_ORIGIN"
    echo "      IP Cloudflare pada DNS publik adalah NORMAL saat 🟠."
elif [ "$CF_ORIGIN" = "$PUBLIC_IP" ] && [ "$CF_PROXY_STATUS" = "false" ]; then
    CF_DIRECT=1
    ok "CloudFront ($CF_DOMAIN) = $PUBLIC_IP | DNS Only 🔘"
else
    warn "CloudFront $CF_DOMAIN tidak sesuai: origin=${CF_ORIGIN:-tidak ada}, VPS=$PUBLIC_IP, proxy=${CF_PROXY_STATUS:-unknown}."
    DNS_OK=0
fi

# ============================================================
# CLOUDFLARE CF DOMAIN — WAJIB DNS ONLY
# ============================================================
# Jangan pernah mengaktifkan Proxy pada cf.<domain> selama proses
# ganti domain. SSL standalone membutuhkan koneksi langsung ke VPS.
if [ "${CF_PROXY_STATUS:-}" = "true" ]; then
    warn "$CF_DOMAIN masih PROXIED 🟠 — akan diubah menjadi DNS Only 🔘."
    CF_RECORDS=$(cf_find_all_name "$CF_DOMAIN") || die "Gagal membaca record $CF_DOMAIN."
    CF_ID=$(printf '%s' "$CF_RECORDS" | jq -r '.result[] | select(.type == "A") | .id' | head -n1)
    [ -n "$CF_ID" ] || die "Record A $CF_DOMAIN tidak ditemukan."
    CF_BODY=$(jq -nc --arg name "$CF_DOMAIN" --arg ip "$PUBLIC_IP" '{type:"A",name:$name,content:$ip,ttl:1,proxied:false}')
    CF_RESULT=$(cf_api PUT "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$CF_ID" "$CF_BODY") || die "Gagal mengubah $CF_DOMAIN menjadi DNS Only."
    cf_json_ok "$CF_RESULT" || die "Cloudflare menolak DNS Only untuk $CF_DOMAIN."
    ok "$CF_DOMAIN sekarang DNS Only 🔘."
    sleep 5
    CF_PROXY_STATUS=false
fi

if [ "${CF_PROXY_STATUS:-}" = "false" ]; then
    ok "$CF_DOMAIN = DNS Only 🔘 (siap untuk SSL/ganti domain)."
elif [ -z "$CF_STATUS" ]; then
    :
fi

if [ "$DNS_OK" != "1" ]; then
    echo
    echo "CloudFront hari ini memakai hostname: $CF_DOMAIN"
    read -r -p "DNS belum lengkap. Tetap lanjut? [y/N]: " ANSWER
    [[ "$ANSWER" =~ ^[Yy]$ ]] || die "Dibatalkan. Perbaiki DNS Cloudflare terlebih dahulu."
fi

echo
echo "============================================================"
echo "Domain lama : ${CURRENT_DOMAIN:-tidak ditemukan}"
echo "Domain baru : $NEW_DOMAIN"
echo "CloudFront  : $CF_DOMAIN"
echo "============================================================"
echo

read -r -p "Lanjut mengganti domain? [y/N]: " CONFIRM
[[ "$CONFIRM" =~ ^[Yy]$ ]] || die "Dibatalkan."

# ============================================================
# BACKUP
# ============================================================

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="$BACKUP_ROOT/$TIMESTAMP"

mkdir -p "$BACKUP_DIR"

cp -a "$XRAY_CONF" "$BACKUP_DIR/xray.conf" 2>/dev/null || true
cp -a "$DEFAULT_CONF" "$BACKUP_DIR/default.conf" 2>/dev/null || true
cp -a "$CERT_FILE" "$BACKUP_DIR/xray.crt" 2>/dev/null || true
cp -a "$KEY_FILE" "$BACKUP_DIR/xray.key" 2>/dev/null || true
cp -a "$CF_NGINX_CONF" "$BACKUP_DIR/cloudfront-nginx.conf" 2>/dev/null || true

ok "Backup dibuat:"
echo "  $BACKUP_DIR"
echo

# ============================================================
# UPDATE CLOUDFRONT NGINX
# ============================================================

info "Memperbarui konfigurasi Nginx CloudFront..."

cat > "$CF_NGINX_CONF" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $CF_DOMAIN;
    location / {
        return 301 https://\$host\$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $CF_DOMAIN;
    ssl_certificate $CERT_FILE;
    ssl_certificate_key $KEY_FILE;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /vmess-cloudfront {
        proxy_pass http://127.0.0.1:10010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /vless-cloudfront {
        proxy_pass http://127.0.0.1:10011;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /trojan-cloudfront {
        proxy_pass http://127.0.0.1:10012;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location / { return 404; }
}
EOF

# ============================================================
# SIMPAN DOMAIN BARU
# ============================================================

printf '%s\n' "$NEW_DOMAIN" > "$DOMAIN_FILE"
chmod 600 "$DOMAIN_FILE"

ok "Domain baru disimpan ke $DOMAIN_FILE"

# ============================================================
# UPDATE SERVER_NAME
# ============================================================

info "Mengubah konfigurasi server_name..."

update_server_name() {
    local file="$1"

    [ -f "$file" ] || return 0

    if grep -qE '^[[:space:]]*server_name[[:space:]]+' "$file"; then
        sed -i -E \
            "0,/^[[:space:]]*server_name[[:space:]]+[^;]+;/s//server_name $NEW_DOMAIN;/" \
            "$file"
    fi
}

update_server_name "$XRAY_CONF"
update_server_name "$DEFAULT_CONF"

# ============================================================
# STOP NGINX
# ============================================================

cd "$MARZBAN_DIR"

info "Menghentikan Nginx sementara..."
docker compose stop nginx >/dev/null 2>&1 || true
sleep 2

# ============================================================
# AUTO FIX-SSL
# ============================================================

echo
info "Menjalankan fix-ssl otomatis..."

if command -v fix-ssl >/dev/null 2>&1; then

    if fix-ssl; then
        ok "fix-ssl selesai dengan sukses."
    else
        warn "fix-ssl gagal."

        # Kembalikan domain file ke domain sebelumnya jika tersedia.
        if [ -n "$CURRENT_DOMAIN" ]; then
            printf '%s\n' "$CURRENT_DOMAIN" > "$DOMAIN_FILE"
        fi

        cp -a "$BACKUP_DIR/xray.conf" "$XRAY_CONF" 2>/dev/null || true
        cp -a "$BACKUP_DIR/default.conf" "$DEFAULT_CONF" 2>/dev/null || true

        docker compose up -d nginx marzban >/dev/null 2>&1 || true

        die "Domain tidak diterapkan karena SSL gagal."
    fi

else
    warn "fix-ssl tidak ditemukan."
    die "fix-ssl wajib tersedia untuk mengganti domain."
fi

# ============================================================
# PASTIKAN SSL MENCAKUP CLOUDFRONT
# Xray CloudFront hari ini memakai cf.<domain> pada port 443.
# Sertifikat wajib memiliki SAN untuk domain utama DAN CF_DOMAIN.
# ============================================================

info "Memeriksa SAN SSL untuk CloudFront..."

CERT_SAN_OK=0
if [ -f "$CERT_FILE" ] &&
   openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$NEW_DOMAIN" &&
   openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$CF_DOMAIN"; then
    CERT_SAN_OK=1
fi

if [ "$CERT_SAN_OK" = "1" ]; then
    ok "SSL SAN sudah mencakup $NEW_DOMAIN + $CF_DOMAIN."
else
    warn "SSL saat ini belum mencakup $CF_DOMAIN. Menerbitkan sertifikat gabungan..."

    docker compose stop nginx >/dev/null 2>&1 || true
    sleep 2

    ACME_HOME="${HOME}/.acme.sh"
    ACME_BIN="$ACME_HOME/acme.sh"
    if [ ! -x "$ACME_BIN" ] && command -v acme.sh >/dev/null 2>&1; then
        ACME_BIN="$(command -v acme.sh)"
    fi

    [ -x "$ACME_BIN" ] || die "acme.sh tidak ditemukan untuk menerbitkan SSL CloudFront."

    ACME_DOMAIN_DIR="$ACME_HOME/${NEW_DOMAIN}_ecc"
    if ! "$ACME_BIN" --issue --standalone \
        -d "$NEW_DOMAIN" \
        -d "$CF_DOMAIN" \
        --keylength ec-256 \
        --server letsencrypt \
        --force; then
        die "SSL gabungan $NEW_DOMAIN + $CF_DOMAIN gagal diterbitkan."
    fi

    if [ ! -f "$ACME_DOMAIN_DIR/fullchain.cer" ] || [ ! -f "$ACME_DOMAIN_DIR/${NEW_DOMAIN}.key" ]; then
        die "File sertifikat CloudFront tidak ditemukan setelah issue SSL."
    fi

    install -m 600 "$ACME_DOMAIN_DIR/fullchain.cer" "$CERT_FILE"
    install -m 600 "$ACME_DOMAIN_DIR/${NEW_DOMAIN}.key" "$KEY_FILE"

    if ! openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$CF_DOMAIN"; then
        die "Sertifikat baru tidak memiliki SAN $CF_DOMAIN."
    fi

    ok "SSL CloudFront berhasil diterbitkan untuk $NEW_DOMAIN + $CF_DOMAIN."
fi

# ============================================================
# CLOUDFLARE CF DOMAIN — PROXIED SETELAH GANTI DOMAIN
# ============================================================
# Setelah SSL/ganti domain selesai, cf.<domain> dikembalikan ke Proxied.
info "Memastikan $CF_DOMAIN menjadi Proxied setelah SSL..."
CF_RECORDS=$(cf_find_all_name "$CF_DOMAIN") || die "Gagal membaca record $CF_DOMAIN setelah SSL."
CF_ID=$(printf '%s' "$CF_RECORDS" | jq -r '.result[] | select(.type == "A") | .id' | head -n1)
if [ -n "$CF_ID" ]; then
    CF_BODY=$(jq -nc --arg name "$CF_DOMAIN" --arg ip "$PUBLIC_IP" '{type:"A",name:$name,content:$ip,ttl:1,proxied:true}')
    CF_RESULT=$(cf_api PUT "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$CF_ID" "$CF_BODY") || die "Gagal mengaktifkan Proxy $CF_DOMAIN."
    cf_json_ok "$CF_RESULT" || die "Cloudflare menolak Proxy $CF_DOMAIN."
    ok "$CF_DOMAIN sekarang PROXIED 🟠."
fi

# ============================================================
# TUNGGU MARZBAN SIAP
# ============================================================

info "Menunggu Marzban siap..."

for i in $(seq 1 30); do
    if ss -lntp 2>/dev/null | grep -q ':12800 '; then
        break
    fi
    sleep 2
done

# Pastikan container aktif.
docker compose up -d marzban nginx >/dev/null 2>&1 || true

sleep 5

# ============================================================
# AUTO BUAT TOKEN
# ============================================================

echo
info "Membuat token API otomatis..."

if command -v buat_token >/dev/null 2>&1; then

    TOKEN_OK=0

    for i in 1 2 3 4 5; do
        if buat_token >/dev/null 2>&1; then
            if [ -s /etc/data/token.json ] &&
               ! grep -q '<html\|404 Not Found' /etc/data/token.json 2>/dev/null; then
                TOKEN_OK=1
                break
            fi
        fi

        sleep 3
    done

    if [ "$TOKEN_OK" = "1" ]; then
        ok "Token API berhasil dibuat."
    else
        warn "Token API belum berhasil dibuat."
        warn "Jalankan 'buat_token' secara manual jika diperlukan."
    fi

else
    warn "buat_token tidak ditemukan."
fi

# ============================================================
# FINAL RESTART
# ============================================================

info "Menjalankan ulang Marzban dan Nginx..."

docker compose up -d marzban nginx >/dev/null 2>&1 || {
    warn "Gagal menjalankan ulang Marzban/Nginx."
}

sleep 3

# ============================================================
# VERIFY DOMAIN
# ============================================================

echo
echo "============================================================"
echo "                 VERIFIKASI DOMAIN"
echo "============================================================"

STORED_DOMAIN=$(cat "$DOMAIN_FILE" 2>/dev/null)

echo "Domain tersimpan : $STORED_DOMAIN"

if [ "$STORED_DOMAIN" = "$NEW_DOMAIN" ]; then
    ok "Domain berhasil disimpan."
else
    warn "Domain file tidak sesuai."
fi

if [ -f "$DEFAULT_CONF" ]; then
    if grep -q "server_name $NEW_DOMAIN;" "$DEFAULT_CONF"; then
        ok "Nginx server_name sudah menggunakan domain baru."
    fi
fi

echo
echo "============================================================"
echo "             GANTI DOMAIN SELESAI"
echo "============================================================"
echo
echo "Domain baru : $NEW_DOMAIN"
echo "CloudFront  : $CF_DOMAIN (Proxy 🟠)"
echo "SSL         : $CERT_FILE"
echo "Backup      : $BACKUP_DIR"
echo "CF API      : $CF_API_CONF"
echo
echo "Cloudflare otomatis:"
echo "  @      → $PUBLIC_IP 🔘 (DNS Only)"
echo "  cf     → $PUBLIC_IP 🟠 (Proxied setelah SSL)"
echo "  wildcard/CNAME → TIDAK disentuh oleh ganti_domain"
echo
echo "============================================================"
