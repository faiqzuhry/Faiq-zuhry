#!/bin/bash

MARZBAN_DIR="/opt/marzban"
XRAY_CONF="/opt/marzban/xray.conf"
DEFAULT_CONF="/opt/marzban/default.conf"
CERT_FILE="/var/lib/marzban/xray.crt"
KEY_FILE="/var/lib/marzban/xray.key"
DOMAIN_FILE="/etc/data/domain"
BACKUP_ROOT="/opt/marzban/domain-backups"
CF_DOMAIN_PREFIX="cf."
CF_NGINX_CONF="/opt/marzban/cloudfront-nginx.conf"
CF_XRAY_SERVICE="xray-cloudfront.service"

info() {
    echo -e "\033[1;36m[INFO]\033[0m $1"
}

ok() {
    echo -e "\033[1;32m[ OK ]\033[0m $1"
}

warn() {
    echo -e "\033[1;33m[WARN]\033[0m $1"
}

error() {
    echo -e "\033[1;31m[ERR ]\033[0m $1"
}

die() {
    error "$1"
    exit 1
}

if [ "$(id -u)" != "0" ]; then
    die "Jalankan sebagai root."
fi

[ -d "$MARZBAN_DIR" ] || die "$MARZBAN_DIR tidak ditemukan."
[ -f "$MARZBAN_DIR/docker-compose.yml" ] || die "docker-compose.yml tidak ditemukan."

command -v docker >/dev/null 2>&1 || die "Docker tidak ditemukan."
docker compose version >/dev/null 2>&1 || die "Docker Compose tidak tersedia."
command -v curl >/dev/null 2>&1 || die "curl tidak ditemukan."

mkdir -p /etc/data "$BACKUP_ROOT"

clear 2>/dev/null

echo
echo "============================================================"
echo "              MARZBAN DOMAIN CHANGER"
echo "============================================================"
echo

# ============================================================
# DOMAIN LAMA
# ============================================================

CURRENT_DOMAIN=""

# Prioritas pertama: domain yang sebelumnya disimpan installer.
if [ -s "$DOMAIN_FILE" ]; then
    SAVED_DOMAIN=$(tr -d '[:space:]' < "$DOMAIN_FILE")

    if echo "$SAVED_DOMAIN" | grep -Eq \
        '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
        CURRENT_DOMAIN="$SAVED_DOMAIN"
    fi
fi

# Fallback: cari server_name domain valid dari konfigurasi.
if [ -z "$CURRENT_DOMAIN" ]; then
    for CONF in "$DEFAULT_CONF" "$XRAY_CONF" "$MARZBAN_DIR/nginx.conf"; do
        if [ -f "$CONF" ]; then
            FOUND=$(grep -Eo \
                'server_name[[:space:]]+[A-Za-z0-9.-]+\.[A-Za-z]{2,63}' \
                "$CONF" 2>/dev/null |
                head -n1 |
                awk '{print $2}')

            if echo "$FOUND" | grep -Eq \
                '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
                CURRENT_DOMAIN="$FOUND"
                break
            fi
        fi
    done
fi

echo "Domain saat ini:"
echo "  ${CURRENT_DOMAIN:-tidak ditemukan}"
echo

# ============================================================
# INPUT DOMAIN BARU
# ============================================================

read -r -p "Masukkan DOMAIN BARU: " NEW_DOMAIN

NEW_DOMAIN=$(printf '%s' "$NEW_DOMAIN" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[[:space:]]//g')

NEW_DOMAIN="${NEW_DOMAIN#http://}"
NEW_DOMAIN="${NEW_DOMAIN#https://}"
NEW_DOMAIN="${NEW_DOMAIN%%/*}"
NEW_DOMAIN="${NEW_DOMAIN%.}"

if ! echo "$NEW_DOMAIN" | grep -Eq \
    '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
    die "Format domain tidak valid: $NEW_DOMAIN"
fi

CF_DOMAIN="${CF_DOMAIN_PREFIX}${NEW_DOMAIN}"

# ============================================================
# PUBLIC IP
# ============================================================

info "Mendeteksi IP publik VPS..."

PUBLIC_IP=$(curl -4fsS --max-time 10 https://api.ipify.org 2>/dev/null)

[ -n "$PUBLIC_IP" ] || die "Gagal mendeteksi IP publik VPS."

echo "IP VPS : $PUBLIC_IP"
echo

# ============================================================
# DNS MAIN + CLOUDFRONT
# ============================================================

resolve_a_all() {
    local d="$1"
    if command -v dig >/dev/null 2>&1; then
        dig +short A "$d" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
    elif command -v getent >/dev/null 2>&1; then
        getent ahostsv4 "$d" 2>/dev/null | awk '{print $1}' | sort -u
    else
        curl -4fsS --max-time 10 "https://dns.google/resolve?name=$d&type=A" 2>/dev/null |
            grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u
    fi
}

# Cloudflare IPv4 ranges. Record Proxied (orange cloud) akan mengembalikan
# IP edge Cloudflare, bukan origin IP VPS. Jadi IP seperti 104.21.x.x
# TIDAK boleh dianggap sebagai DNS yang salah.
is_cloudflare_ipv4() {
    local ip="$1"
    local a b c d n
    IFS=. read -r a b c d <<< "$ip"
    n=$((a*16777216 + b*65536 + c*256 + d))

    local ranges=(
        "173.245.48.0/20" "103.21.244.0/22" "103.22.200.0/22"
        "103.31.4.0/22" "141.101.64.0/18" "108.162.192.0/18"
        "190.93.240.0/20" "188.114.96.0/20" "197.234.240.0/22"
        "198.41.128.0/17" "162.158.0.0/15" "104.16.0.0/13"
        "104.24.0.0/14" "172.64.0.0/13" "131.0.72.0/22"
    )

    local cidr base bits mask
    for cidr in "${ranges[@]}"; do
        base=${cidr%/*}
        bits=${cidr#*/}
        IFS=. read -r a b c d <<< "$base"
        base=$((a*16777216 + b*65536 + c*256 + d))
        mask=$(( (0xFFFFFFFF << (32-bits)) & 0xFFFFFFFF ))
        if (( (n & mask) == (base & mask) )); then
            return 0
        fi
    done
    return 1
}

info "Mengecek DNS domain utama + CloudFront..."
DNS_MAIN_LIST=$(resolve_a_all "$NEW_DOMAIN")
DNS_CF_LIST=$(resolve_a_all "$CF_DOMAIN")
DNS_MAIN=$(printf '%s\n' "$DNS_MAIN_LIST" | head -n1)
DNS_CF=$(printf '%s\n' "$DNS_CF_LIST" | head -n1)

CF_PROXY=0
CF_DIRECT=0
CF_UNKNOWN=0

if [ -n "$DNS_CF_LIST" ]; then
    while IFS= read -r ip; do
        [ -n "$ip" ] || continue
        if is_cloudflare_ipv4 "$ip"; then
            CF_PROXY=1
        elif [ "$ip" = "$PUBLIC_IP" ]; then
            CF_DIRECT=1
        else
            CF_UNKNOWN=1
        fi
    done <<< "$DNS_CF_LIST"
fi

echo "Domain utama : $NEW_DOMAIN"
echo "DNS         : ${DNS_MAIN_LIST:-tidak ditemukan}"
echo "CloudFront  : $CF_DOMAIN"
echo "DNS CF      : ${DNS_CF_LIST:-tidak ditemukan}"
echo

DNS_OK=1
if printf '%s\n' "$DNS_MAIN_LIST" | grep -Fxq "$PUBLIC_IP"; then
    ok "DNS domain utama sudah mengarah ke VPS."
else
    warn "DNS domain utama belum mengarah ke IP VPS."
    DNS_OK=0
fi

if [ "$CF_PROXY" = "1" ] && [ "$CF_DIRECT" = "0" ]; then
    ok "CloudFront ($CF_DOMAIN) terdeteksi PROXIED 🟠 oleh Cloudflare."
    echo "      IP yang terlihat dari VPS: $DNS_CF_LIST"
    echo "      Origin IP Cloudflare tetap: $PUBLIC_IP"
    echo
    warn "Ini NORMAL. IP Cloudflare berbeda dari IP origin VPS karena Proxy aktif."
    echo "      Untuk penerbitan SSL standalone, $CF_DOMAIN harus sementara DNS Only ☁️."
    echo
    read -r -p "Setelah mengubah $CF_DOMAIN menjadi DNS Only, lanjutkan? [y/N]: " ANSWER
    [[ "$ANSWER" =~ ^[Yy]$ ]] || die "Dibatalkan. Ubah $CF_DOMAIN menjadi DNS Only lalu jalankan ulang."

    # Re-check setelah pengguna diberi kesempatan mengubah orange cloud.
    sleep 2
    DNS_CF_LIST=$(resolve_a_all "$CF_DOMAIN")
    echo "DNS CF setelah pengecekan ulang : ${DNS_CF_LIST:-tidak ditemukan}"

    CF_PROXY=0
    CF_DIRECT=0
    CF_UNKNOWN=0
    if [ -n "$DNS_CF_LIST" ]; then
        while IFS= read -r ip; do
            [ -n "$ip" ] || continue
            if is_cloudflare_ipv4 "$ip"; then
                CF_PROXY=1
            elif [ "$ip" = "$PUBLIC_IP" ]; then
                CF_DIRECT=1
            else
                CF_UNKNOWN=1
            fi
        done <<< "$DNS_CF_LIST"
    fi

    if [ "$CF_DIRECT" = "1" ]; then
        ok "DNS CloudFront sekarang DIRECT ke VPS."
    else
        warn "CloudFront masih belum terlihat DIRECT ke IP VPS."
        warn "Jika DNS baru saja diubah, tunggu propagasi lalu jalankan ulang."
        die "SSL standalone tidak dilanjutkan agar tidak gagal karena Cloudflare Proxy."
    fi
elif [ "$CF_DIRECT" = "1" ] && [ "$CF_PROXY" = "0" ]; then
    ok "DNS CloudFront ($CF_DOMAIN) sudah DIRECT ke VPS."
elif [ -z "$DNS_CF_LIST" ]; then
    warn "DNS CloudFront ($CF_DOMAIN) tidak ditemukan."
    DNS_OK=0
else
    warn "DNS CloudFront ($CF_DOMAIN) terdeteksi mengarah ke IP yang bukan VPS dan bukan Cloudflare."
    DNS_OK=0
fi

if [ "$DNS_OK" != "1" ]; then
    echo
    echo "CloudFront hari ini memakai hostname: $CF_DOMAIN"
    read -r -p "DNS belum lengkap. Tetap lanjut? [y/N]: " ANSWER
    [[ "$ANSWER" =~ ^[Yy]$ ]] || die "Dibatalkan. Perbaiki DNS domain utama terlebih dahulu."
fi

echo
echo "============================================================"
echo "Domain lama : ${CURRENT_DOMAIN:-tidak ditemukan}"
echo "Domain baru : $NEW_DOMAIN"
echo "CloudFront  : $CF_DOMAIN"
echo "============================================================"
echo

read -r -p "Lanjut mengganti domain? [y/N]: " CONFIRM
[[ "$CONFIRM" =~ ^[Yy]$ ]] || die "Dibatalkan."

# ============================================================
# BACKUP
# ============================================================

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="$BACKUP_ROOT/$TIMESTAMP"

mkdir -p "$BACKUP_DIR"

cp -a "$XRAY_CONF" "$BACKUP_DIR/xray.conf" 2>/dev/null || true
cp -a "$DEFAULT_CONF" "$BACKUP_DIR/default.conf" 2>/dev/null || true
cp -a "$CERT_FILE" "$BACKUP_DIR/xray.crt" 2>/dev/null || true
cp -a "$KEY_FILE" "$BACKUP_DIR/xray.key" 2>/dev/null || true
cp -a "$CF_NGINX_CONF" "$BACKUP_DIR/cloudfront-nginx.conf" 2>/dev/null || true

ok "Backup dibuat:"
echo "  $BACKUP_DIR"
echo

# ============================================================
# UPDATE CLOUDFRONT NGINX
# ============================================================

info "Memperbarui konfigurasi Nginx CloudFront..."

cat > "$CF_NGINX_CONF" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $CF_DOMAIN;
    location / {
        return 301 https://\$host\$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $CF_DOMAIN;
    ssl_certificate $CERT_FILE;
    ssl_certificate_key $KEY_FILE;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /vmess-cloudfront {
        proxy_pass http://127.0.0.1:10010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /vless-cloudfront {
        proxy_pass http://127.0.0.1:10011;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /trojan-cloudfront {
        proxy_pass http://127.0.0.1:10012;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location / { return 404; }
}
EOF

# ============================================================
# SIMPAN DOMAIN BARU
# ============================================================

printf '%s\n' "$NEW_DOMAIN" > "$DOMAIN_FILE"
chmod 600 "$DOMAIN_FILE"

ok "Domain baru disimpan ke $DOMAIN_FILE"

# ============================================================
# UPDATE SERVER_NAME
# ============================================================

info "Mengubah konfigurasi server_name..."

update_server_name() {
    local file="$1"

    [ -f "$file" ] || return 0

    if grep -qE '^[[:space:]]*server_name[[:space:]]+' "$file"; then
        sed -i -E \
            "0,/^[[:space:]]*server_name[[:space:]]+[^;]+;/s//server_name $NEW_DOMAIN;/" \
            "$file"
    fi
}

update_server_name "$XRAY_CONF"
update_server_name "$DEFAULT_CONF"

# ============================================================
# STOP NGINX
# ============================================================

cd "$MARZBAN_DIR"

info "Menghentikan Nginx sementara..."
docker compose stop nginx >/dev/null 2>&1 || true
sleep 2

# ============================================================
# AUTO FIX-SSL
# ============================================================

echo
info "Menjalankan fix-ssl otomatis..."

if command -v fix-ssl >/dev/null 2>&1; then

    if fix-ssl; then
        ok "fix-ssl selesai dengan sukses."
    else
        warn "fix-ssl gagal."

        # Kembalikan domain file ke domain sebelumnya jika tersedia.
        if [ -n "$CURRENT_DOMAIN" ]; then
            printf '%s\n' "$CURRENT_DOMAIN" > "$DOMAIN_FILE"
        fi

        cp -a "$BACKUP_DIR/xray.conf" "$XRAY_CONF" 2>/dev/null || true
        cp -a "$BACKUP_DIR/default.conf" "$DEFAULT_CONF" 2>/dev/null || true

        docker compose up -d nginx marzban >/dev/null 2>&1 || true

        die "Domain tidak diterapkan karena SSL gagal."
    fi

else
    warn "fix-ssl tidak ditemukan."
    die "fix-ssl wajib tersedia untuk mengganti domain."
fi

# ============================================================
# PASTIKAN SSL MENCAKUP CLOUDFRONT
# Xray CloudFront hari ini memakai cf.<domain> pada port 443.
# Sertifikat wajib memiliki SAN untuk domain utama DAN CF_DOMAIN.
# ============================================================

info "Memeriksa SAN SSL untuk CloudFront..."

CERT_SAN_OK=0
if [ -f "$CERT_FILE" ] &&
   openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$NEW_DOMAIN" &&
   openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$CF_DOMAIN"; then
    CERT_SAN_OK=1
fi

if [ "$CERT_SAN_OK" = "1" ]; then
    ok "SSL SAN sudah mencakup $NEW_DOMAIN + $CF_DOMAIN."
else
    warn "SSL saat ini belum mencakup $CF_DOMAIN. Menerbitkan sertifikat gabungan..."

    docker compose stop nginx >/dev/null 2>&1 || true
    sleep 2

    ACME_HOME="${HOME}/.acme.sh"
    ACME_BIN="$ACME_HOME/acme.sh"
    if [ ! -x "$ACME_BIN" ] && command -v acme.sh >/dev/null 2>&1; then
        ACME_BIN="$(command -v acme.sh)"
    fi

    [ -x "$ACME_BIN" ] || die "acme.sh tidak ditemukan untuk menerbitkan SSL CloudFront."

    ACME_DOMAIN_DIR="$ACME_HOME/${NEW_DOMAIN}_ecc"
    if ! "$ACME_BIN" --issue --standalone \
        -d "$NEW_DOMAIN" \
        -d "$CF_DOMAIN" \
        --keylength ec-256 \
        --server letsencrypt \
        --force; then
        die "SSL gabungan $NEW_DOMAIN + $CF_DOMAIN gagal diterbitkan."
    fi

    if [ ! -f "$ACME_DOMAIN_DIR/fullchain.cer" ] || [ ! -f "$ACME_DOMAIN_DIR/${NEW_DOMAIN}.key" ]; then
        die "File sertifikat CloudFront tidak ditemukan setelah issue SSL."
    fi

    install -m 600 "$ACME_DOMAIN_DIR/fullchain.cer" "$CERT_FILE"
    install -m 600 "$ACME_DOMAIN_DIR/${NEW_DOMAIN}.key" "$KEY_FILE"

    if ! openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$CF_DOMAIN"; then
        die "Sertifikat baru tidak memiliki SAN $CF_DOMAIN."
    fi

    ok "SSL CloudFront berhasil diterbitkan untuk $NEW_DOMAIN + $CF_DOMAIN."
fi

# ============================================================
# TUNGGU MARZBAN SIAP
# ============================================================

info "Menunggu Marzban siap..."

for i in $(seq 1 30); do
    if ss -lntp 2>/dev/null | grep -q ':12800 '; then
        break
    fi
    sleep 2
done

# Pastikan container aktif.
docker compose up -d marzban nginx >/dev/null 2>&1 || true

sleep 5

# ============================================================
# AUTO BUAT TOKEN
# ============================================================

echo
info "Membuat token API otomatis..."

if command -v buat_token >/dev/null 2>&1; then

    TOKEN_OK=0

    for i in 1 2 3 4 5; do
        if buat_token >/dev/null 2>&1; then
            if [ -s /etc/data/token.json ] &&
               ! grep -q '<html\|404 Not Found' /etc/data/token.json 2>/dev/null; then
                TOKEN_OK=1
                break
            fi
        fi

        sleep 3
    done

    if [ "$TOKEN_OK" = "1" ]; then
        ok "Token API berhasil dibuat."
    else
        warn "Token API belum berhasil dibuat."
        warn "Jalankan 'buat_token' secara manual jika diperlukan."
    fi

else
    warn "buat_token tidak ditemukan."
fi

# ============================================================
# FINAL RESTART
# ============================================================

info "Menjalankan ulang Marzban dan Nginx..."

docker compose up -d marzban nginx >/dev/null 2>&1 || {
    warn "Gagal menjalankan ulang Marzban/Nginx."
}

sleep 3

# ============================================================
# VERIFY DOMAIN
# ============================================================

echo
echo "============================================================"
echo "                 VERIFIKASI DOMAIN"
echo "============================================================"

STORED_DOMAIN=$(cat "$DOMAIN_FILE" 2>/dev/null)

echo "Domain tersimpan : $STORED_DOMAIN"

if [ "$STORED_DOMAIN" = "$NEW_DOMAIN" ]; then
    ok "Domain berhasil disimpan."
else
    warn "Domain file tidak sesuai."
fi

if [ -f "$DEFAULT_CONF" ]; then
    if grep -q "server_name $NEW_DOMAIN;" "$DEFAULT_CONF"; then
        ok "Nginx server_name sudah menggunakan domain baru."
    fi
fi

echo
echo "============================================================"
echo "             GANTI DOMAIN SELESAI"
echo "============================================================"
echo
echo "Domain baru : $NEW_DOMAIN"
echo "CloudFront  : $CF_DOMAIN"
echo "SSL         : $CERT_FILE"
echo "Backup      : $BACKUP_DIR"
echo
echo "============================================================"
