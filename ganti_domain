#!/bin/bash

MARZBAN_DIR="/opt/marzban"
XRAY_CONF="/opt/marzban/xray.conf"
DEFAULT_CONF="/opt/marzban/default.conf"
CERT_FILE="/var/lib/marzban/xray.crt"
KEY_FILE="/var/lib/marzban/xray.key"
DOMAIN_FILE="/etc/data/domain"
BACKUP_ROOT="/opt/marzban/domain-backups"
ORIGIN_DOMAIN_PREFIX="origin."
CF_DOMAIN_PREFIX="cf."
CLOUDFRONT_DOMAIN_FILE="/etc/data/cloudfront_distribution_domain"
CF_NGINX_CONF="/opt/marzban/cloudfront-nginx.conf"
CF_XRAY_SERVICE="xray-cloudfront.service"
CF_API_CONF="/etc/data/cloudflare_dns.conf"
CF_API_BASE="https://api.cloudflare.com/client/v4"
CF_TEMPORARY_DNS_ONLY=0


info() {
    echo -e "\033[1;36m[INFO]\033[0m $1"
}

ok() {
    echo -e "\033[1;32m[ OK ]\033[0m $1"
}

warn() {
    echo -e "\033[1;33m[WARN]\033[0m $1"
}

error() {
    echo -e "\033[1;31m[ERR ]\033[0m $1"
}

die() {
    error "$1"
    exit 1
}

# ============================================================
# CLOUDFLARE API — AUTO DNS SYNC
# - @      -> IP VPS (DNS Only)
# - cf     -> IP VPS (DNS Only selama proses SSL, lalu Proxy)
# - wildcard/CNAME yang sudah ada -> TIDAK disentuh
# API Token digunakan untuk sinkronisasi record @ dan cf.
# Token disimpan lokal dengan permission 600.
# ============================================================

cf_json_ok() {
    printf '%s' "$1" | jq -e '.success == true' >/dev/null 2>&1
}

cf_api() {
    local method="$1" url="$2" data="${3:-}"
    if [ -n "$data" ]; then
        curl -fsS --max-time 20 -X "$method" "$url" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" \
            --data "$data"
    else
        curl -fsS --max-time 20 -X "$method" "$url" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json"
    fi
}

load_cf_credentials() {
    mkdir -p /etc/data
    chmod 700 /etc/data

    if [ -f "$CF_API_CONF" ]; then
        # shellcheck disable=SC1090
        . "$CF_API_CONF"
    fi

    # Token selalu divalidasi sebelum dipakai. Jika file token lama tidak ada,
    # kosong, atau invalid/expired, minta token baru tanpa membuat file rusak.
    local token_verify token_error
    if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then
        token_verify=$(curl -sS --max-time 20 \
            "$CF_API_BASE/user/tokens/verify" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" 2>/dev/null || true)
        if ! cf_json_ok "$token_verify"; then
            warn "Cloudflare API Token tersimpan tidak valid/ditolak. Meminta token baru..."
            unset CLOUDFLARE_API_TOKEN
        fi
    fi

    if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
        echo
        echo "Cloudflare API diperlukan untuk sinkronisasi @ dan cf."
        echo "Buat API Token dengan permission Zone > DNS > Read + Edit."
        echo "Zone Resources: Include → Specific zone → pilih domain yang diperlukan."
        echo "Token hanya akan disimpan di $CF_API_CONF (permission 600)."
        echo
        read -r -s -p "Cloudflare API Token: " CLOUDFLARE_API_TOKEN
        echo
        [ -n "$CLOUDFLARE_API_TOKEN" ] || die "Cloudflare API Token kosong."

        token_verify=$(curl -sS --max-time 20 \
            "$CF_API_BASE/user/tokens/verify" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" 2>/dev/null || true)
        if ! cf_json_ok "$token_verify"; then
            token_error=$(printf '%s' "$token_verify" | jq -r '.errors[0].message // empty' 2>/dev/null || true)
            [ -n "$token_error" ] && echo "Cloudflare: $token_error"
            die "Cloudflare API Token tidak valid."
        fi
        ok "Cloudflare API Token valid."
    fi

    # Cari zone baru. Jika NEW_DOMAIN adalah hostname, cari root zone otomatis.
    info "Mendeteksi root Zone ID Cloudflare untuk domain baru $NEW_DOMAIN..."
    local zone_info zone_json candidate
    zone_info=""
    candidate="$NEW_DOMAIN"
    while :; do
        zone_json=$(curl -fsS --max-time 20 -G "$CF_API_BASE/zones" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" \
            --data-urlencode "name=$candidate" \
            --data-urlencode "status=active" \
            --data-urlencode "per_page=1") || zone_json=""
        CLOUDFLARE_ZONE_ID=$(printf '%s' "$zone_json" | jq -r '.result[0].id // empty' 2>/dev/null || true)
        if [ -n "$CLOUDFLARE_ZONE_ID" ]; then
            zone_info=$(printf '%s' "$zone_json" | jq -r '.result[0].name // empty')
            break
        fi
        [[ "$candidate" == *.*.* ]] || break
        candidate="${candidate#*.}"
    done

    if [ -z "${CLOUDFLARE_ZONE_ID:-}" ]; then
        read -r -p "Cloudflare Zone ID $NEW_DOMAIN (opsional jika auto-detect gagal): " CLOUDFLARE_ZONE_ID
    fi
    [ -n "${CLOUDFLARE_ZONE_ID:-}" ] || die "Cloudflare Zone ID untuk $NEW_DOMAIN tidak ditemukan."

    local verify verify_name
    verify=$(cf_api GET "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID" 2>/dev/null || true)
    cf_json_ok "$verify" || die "Cloudflare API gagal. Periksa API Token / Zone ID."
    verify_name=$(printf '%s' "$verify" | jq -r '.result.name // empty')
    [ -n "$verify_name" ] || die "Nama zone Cloudflare tidak dapat dibaca."
    # Zone harus menjadi suffix/root dari NEW_DOMAIN.
    case ".$NEW_DOMAIN" in
        *".$verify_name"|".$verify_name") : ;;
        *) die "Zone ID $CLOUDFLARE_ZONE_ID adalah '$verify_name', tidak cocok dengan '$NEW_DOMAIN'." ;;
    esac

    cat > "$CF_API_CONF" <<EOF
CLOUDFLARE_API_TOKEN='$CLOUDFLARE_API_TOKEN'
CLOUDFLARE_ZONE_ID='$CLOUDFLARE_ZONE_ID'
EOF
    chmod 600 "$CF_API_CONF"
    ok "Cloudflare API terhubung. Zone baru: $verify_name"
}

# Cari root zone dari hostname lama, misalnya m.example.com -> example.com.
find_root_zone_for_host() {
    local host="$1" candidate response id name
    candidate="${host%.}"
    while :; do
        response=$(curl -fsS --max-time 20 -G "$CF_API_BASE/zones" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" \
            --data-urlencode "name=$candidate" \
            --data-urlencode "status=active" \
            --data-urlencode "per_page=1") || response=""
        id=$(printf '%s' "$response" | jq -r '.result[0].id // empty' 2>/dev/null)
        name=$(printf '%s' "$response" | jq -r '.result[0].name // empty' 2>/dev/null)
        if [ -n "$id" ] && [ -n "$name" ]; then
            printf '%s\t%s\n' "$id" "$name"
            return 0
        fi
        [[ "$candidate" == *.*.* ]] || break
        candidate="${candidate#*.}"
    done
    return 1
}

# Ambil A record origin hostname lama dari zone lama. stdout HARUS IP saja;
# semua pesan log dikirim ke stderr agar command substitution tidak mencampurnya.
get_old_origin_ip() {
    local old_name="$1" old_zone_id="$2" records ip
    info "Mengambil IP origin dari hostname lama $old_name..." >&2
    records=$(curl -fsS --max-time 20 -G \
        "$CF_API_BASE/zones/$old_zone_id/dns_records" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data-urlencode "name=$old_name" \
        --data-urlencode "type=A" \
        --data-urlencode "per_page=100") || return 1
    cf_json_ok "$records" || return 1
    ip=$(printf '%s' "$records" | jq -r '.result[] | select(.type=="A") | .content' | head -n1)
    printf '%s' "$ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    printf '%s\n' "$ip"
}

cf_find_records() {
    local name="$1"
    cf_api GET "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records?type=A&name=$(printf '%s' "$name" | sed 's/%/%25/g;s/+/%2B/g;s/ /%20/g')&per_page=100"
}

cf_find_all_name() {
    local name="$1"
    curl -fsS --max-time 20 -G \
        "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data-urlencode "name=$name" \
        --data-urlencode "per_page=100"
}

cf_upsert_a() {
    local name="$1" ip="$2" proxied="${3:-false}" records_json rid body result
    records_json=$(cf_find_all_name "$name") || die "Gagal membaca DNS $name dari Cloudflare."
    rid=$(printf '%s' "$records_json" | jq -r '.result[] | select(.type == "A") | .id' | head -n1)

    if [ -z "$rid" ]; then
        while IFS=$'\t' read -r type old_id; do
            [ -n "$old_id" ] || continue
            case "$type" in
                CNAME|AAAA)
                    local del_result
                    del_result=$(cf_api DELETE "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$old_id" 2>/dev/null || true)
                    cf_json_ok "$del_result" || die "Gagal menghapus record konflik $type $name."
                    ;;
            esac
        done < <(printf '%s' "$records_json" | jq -r '.result[] | [.type,.id] | @tsv')
    fi

    body=$(jq -nc --arg name "$name" --arg ip "$ip" --argjson proxied "$proxied" \
        '{type:"A",name:$name,content:$ip,ttl:1,proxied:$proxied}')

    if [ -n "$rid" ]; then
        result=$(cf_api PUT "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$rid" "$body") || die "Gagal update A $name."
    else
        result=$(cf_api POST "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records" "$body") || die "Gagal membuat A $name."
    fi
    cf_json_ok "$result" || {
        echo "Cloudflare response: $result" >&2
        die "Cloudflare menolak perubahan A $name."
    }
    if [ "$proxied" = "true" ]; then
        ok "Cloudflare A $name → $ip 🟠"
    else
        ok "Cloudflare A $name → $ip 🔘"
    fi
}

cf_upsert_cname() {
    local name="$1" target="$2" proxied="${3:-false}" records_json rid body result
    records_json=$(cf_find_all_name "$name") || die "Gagal membaca DNS $name dari Cloudflare."
    rid=$(printf '%s' "$records_json" | jq -r '.result[] | select(.type == "CNAME") | .id' | head -n1)

    if [ -z "$rid" ]; then
        while IFS=$'\t' read -r type old_id; do
            [ -n "$old_id" ] || continue
            case "$type" in
                A|AAAA)
                    result=$(cf_api DELETE "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$old_id" 2>/dev/null || true)
                    cf_json_ok "$result" || die "Gagal menghapus record konflik $type $name."
                    ;;
            esac
        done < <(printf '%s' "$records_json" | jq -r '.result[] | [.type,.id] | @tsv')
    fi

    body=$(jq -nc --arg name "$name" --arg target "$target" --argjson proxied "$proxied" \
        '{type:"CNAME",name:$name,content:$target,ttl:1,proxied:$proxied}')

    if [ -n "$rid" ]; then
        result=$(cf_api PUT "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records/$rid" "$body") || die "Gagal update CNAME $name."
    else
        result=$(cf_api POST "$CF_API_BASE/zones/$CLOUDFLARE_ZONE_ID/dns_records" "$body") || die "Gagal membuat CNAME $name."
    fi
    cf_json_ok "$result" || {
        echo "Cloudflare response: $result" >&2
        die "Cloudflare menolak perubahan CNAME $name."
    }
    ok "Cloudflare CNAME $name → $target 🔘 (DNS Only)"
}

cloudflare_sync_dns() {
    load_cf_credentials

    [ -n "${CLOUDFRONT_DISTRIBUTION_DOMAIN:-}" ] ||
        die "CloudFront distribution domain belum ditentukan."

    local cf_backup_file="$BACKUP_ROOT/cloudfront-dns-$NEW_DOMAIN-$(date +%Y%m%d-%H%M%S).json"
    mkdir -p "$BACKUP_ROOT"

    {
        printf '{"zone_id":"%s","zone_name":"%s","origin_domain":"%s","cf_domain":"%s","cloudfront_distribution":"%s","records":[' \
            "$CLOUDFLARE_ZONE_ID" "$NEW_DOMAIN" "$ORIGIN_DOMAIN" "$CF_DOMAIN" "$CLOUDFRONT_DISTRIBUTION_DOMAIN"
        cf_find_all_name "$ORIGIN_DOMAIN" | jq -c '.result[]' 2>/dev/null | paste -sd, -
        printf '],"cf_records":['
        cf_find_all_name "$CF_DOMAIN" | jq -c '.result[]' 2>/dev/null | paste -sd, -
        printf ']}'
    } > "$cf_backup_file"
    chmod 600 "$cf_backup_file"
    ok "Backup DNS origin + CloudFront: $cf_backup_file"

    echo
    info "Sinkronisasi DNS untuk AWS CloudFront..."
    echo "  $ORIGIN_DOMAIN → $ORIGIN_IP 🔘 (DNS Only)"
    echo "  $CF_DOMAIN → $CLOUDFRONT_DISTRIBUTION_DOMAIN 🔘 (CNAME, DNS Only)"
    echo "  Wildcard/CNAME lain → TIDAK disentuh"
    echo

    # Origin VPS: harus langsung menuju IP VPS, DNS Only.
    cf_upsert_a "$ORIGIN_DOMAIN" "$ORIGIN_IP" "false"

    # Viewer hostname: harus menunjuk ke distribution AWS CloudFront.
    cf_upsert_cname "$CF_DOMAIN" "$CLOUDFRONT_DISTRIBUTION_DOMAIN" "false"

    ok "DNS origin + CloudFront sudah disinkronkan."
}

cf_restore_proxy_on_exit() {
    # AWS CloudFront memakai CNAME DNS Only.
    # Tidak ada proses mengaktifkan Cloudflare Proxy/orange-cloud.
    return 0
}

trap cf_restore_proxy_on_exit EXIT

if [ "$(id -u)" != "0" ]; then
    die "Jalankan sebagai root."
fi

[ -d "$MARZBAN_DIR" ] || die "$MARZBAN_DIR tidak ditemukan."
[ -f "$MARZBAN_DIR/docker-compose.yml" ] || die "docker-compose.yml tidak ditemukan."
command -v jq >/dev/null 2>&1 || die "jq tidak ditemukan. Install jq terlebih dahulu."

command -v docker >/dev/null 2>&1 || die "Docker tidak ditemukan."
docker compose version >/dev/null 2>&1 || die "Docker Compose tidak tersedia."
command -v curl >/dev/null 2>&1 || die "curl tidak ditemukan."

mkdir -p /etc/data "$BACKUP_ROOT"

clear 2>/dev/null

echo
echo "============================================================"
echo "              MARZBAN DOMAIN CHANGER"
echo "============================================================"
echo

# ============================================================
# DOMAIN LAMA
# ============================================================

CURRENT_DOMAIN=""

# Prioritas pertama: domain yang sebelumnya disimpan installer.
if [ -s "$DOMAIN_FILE" ]; then
    SAVED_DOMAIN=$(tr -d '[:space:]' < "$DOMAIN_FILE")

    if echo "$SAVED_DOMAIN" | grep -Eq \
        '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
        CURRENT_DOMAIN="$SAVED_DOMAIN"
    fi
fi

# Fallback: cari server_name domain valid dari konfigurasi.
if [ -z "$CURRENT_DOMAIN" ]; then
    for CONF in "$DEFAULT_CONF" "$XRAY_CONF" "$MARZBAN_DIR/nginx.conf"; do
        if [ -f "$CONF" ]; then
            FOUND=$(grep -Eo \
                'server_name[[:space:]]+[A-Za-z0-9.-]+\.[A-Za-z]{2,63}' \
                "$CONF" 2>/dev/null |
                head -n1 |
                awk '{print $2}')

            if echo "$FOUND" | grep -Eq \
                '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
                CURRENT_DOMAIN="$FOUND"
                break
            fi
        fi
    done
fi

echo "Domain saat ini:"
echo "  ${CURRENT_DOMAIN:-tidak ditemukan}"
echo

# ============================================================
# INPUT DOMAIN BARU
# ============================================================

read -r -p "Masukkan DOMAIN BARU: " NEW_DOMAIN

NEW_DOMAIN=$(printf '%s' "$NEW_DOMAIN" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[[:space:]]//g')

NEW_DOMAIN="${NEW_DOMAIN#http://}"
NEW_DOMAIN="${NEW_DOMAIN#https://}"
NEW_DOMAIN="${NEW_DOMAIN%%/*}"
NEW_DOMAIN="${NEW_DOMAIN%.}"

if ! echo "$NEW_DOMAIN" | grep -Eq \
    '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'; then
    die "Format domain tidak valid: $NEW_DOMAIN"
fi

ORIGIN_DOMAIN="${ORIGIN_DOMAIN_PREFIX}${NEW_DOMAIN}"
CF_DOMAIN="${CF_DOMAIN_PREFIX}${NEW_DOMAIN}"

# Domain AWS CloudFront distribution.
# Simpan agar ganti_domain berikutnya tidak perlu meminta ulang.
CLOUDFRONT_DISTRIBUTION_DOMAIN=""
if [ -s "$CLOUDFRONT_DOMAIN_FILE" ]; then
    CLOUDFRONT_DISTRIBUTION_DOMAIN="$(tr -d '[:space:]' < "$CLOUDFRONT_DOMAIN_FILE")"
fi

if ! printf '%s' "$CLOUDFRONT_DISTRIBUTION_DOMAIN" | grep -Eq     '^[a-z0-9-]+\.cloudfront\.net$'; then
    echo
    echo "CloudFront AWS sekarang menggunakan CNAME:"
    echo "  $CF_DOMAIN → xxxxx.cloudfront.net"
    read -r -p "Masukkan domain distribution CloudFront AWS: " CLOUDFRONT_DISTRIBUTION_DOMAIN
    CLOUDFRONT_DISTRIBUTION_DOMAIN="$(printf '%s' "$CLOUDFRONT_DISTRIBUTION_DOMAIN" | tr '[:upper:]' '[:lower:]' | sed 's/[[:space:]]//g')"
fi

if ! printf '%s' "$CLOUDFRONT_DISTRIBUTION_DOMAIN" | grep -Eq     '^[a-z0-9-]+\.cloudfront\.net$'; then
    die "Domain distribution CloudFront tidak valid: $CLOUDFRONT_DISTRIBUTION_DOMAIN"
fi

printf '%s\n' "$CLOUDFRONT_DISTRIBUTION_DOMAIN" > "$CLOUDFRONT_DOMAIN_FILE"
chmod 600 "$CLOUDFRONT_DOMAIN_FILE"

# ============================================================
# CLOUDFLARE + IP ORIGIN LAMA
# ============================================================
load_cf_credentials

info "Mendeteksi root Zone ID Cloudflare untuk domain lama $CURRENT_DOMAIN..."
OLD_ZONE_INFO=$(find_root_zone_for_host "$CURRENT_DOMAIN" || true)
OLD_ZONE_ID=$(printf '%s' "$OLD_ZONE_INFO" | awk -F '\t' 'NR==1{print $1}')
OLD_ZONE_NAME=$(printf '%s' "$OLD_ZONE_INFO" | awk -F '\t' 'NR==1{print $2}')
[ -n "$OLD_ZONE_ID" ] || die "Root Zone Cloudflare untuk hostname lama $CURRENT_DOMAIN tidak ditemukan."
ok "Root Zone lama: $OLD_ZONE_NAME (hostname: $CURRENT_DOMAIN)"

OLD_ORIGIN_DOMAIN="origin.${CURRENT_DOMAIN}"
info "Mengambil IP origin dari hostname lama $OLD_ORIGIN_DOMAIN..."
ORIGIN_IP=$(get_old_origin_ip "$OLD_ORIGIN_DOMAIN" "$OLD_ZONE_ID" 2>/dev/null) || {
    warn "A $OLD_ORIGIN_DOMAIN tidak ditemukan. Mencoba fallback ke $CURRENT_DOMAIN..."
    ORIGIN_IP=$(get_old_origin_ip "$CURRENT_DOMAIN" "$OLD_ZONE_ID") ||
        die "Tidak dapat mengambil IP origin dari $OLD_ORIGIN_DOMAIN maupun $CURRENT_DOMAIN."
}

PUBLIC_IP=$(curl -4fsS --max-time 10 https://api.ipify.org 2>/dev/null || true)
printf 'IP origin lama : %s\n' "$ORIGIN_IP"
printf 'IP publik VPS  : %s\n' "${PUBLIC_IP:-tidak terdeteksi}"
echo

# PRE-FLIGHT: pastikan token boleh membaca DNS sebelum ada perubahan.
info "Memeriksa akses DNS Records Cloudflare..."
CF_PREFLIGHT=$(cf_find_all_name "$NEW_DOMAIN" 2>/dev/null || true)
if ! cf_json_ok "$CF_PREFLIGHT"; then
    echo
    error "API Token tidak memiliki akses DNS Records pada $NEW_DOMAIN."
    echo "Pastikan permission: Zone > DNS > Read + Edit."
    echo "Pastikan Zone Resources mencakup zone $NEW_DOMAIN."
    die "Pre-flight Cloudflare gagal. Tidak ada perubahan DNS yang dilakukan."
fi
ok "Akses DNS Records $NEW_DOMAIN: OK."

cloudflare_sync_dns
# ============================================================
# DNS MAIN + CLOUDFRONT
# ============================================================
# PENTING:
# Verifikasi utama menggunakan Cloudflare API (authoritative record).
# Jangan menjadikan hasil resolver publik sebagai sumber kebenaran utama,
# karena setelah perubahan domain resolver dapat masih menyimpan IP lama.
# Contoh: Cloudflare sudah benar 52.x.x.x, tetapi dig masih melihat
# IP lama 13.x.x.x selama masa propagasi/cache.
# CNAME/wildcard yang sudah ada TIDAK disentuh di bagian ini.

resolve_a_all() {
    local d="$1"
    if command -v dig >/dev/null 2>&1; then
        dig +short A "$d" 2>/dev/null |
            grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' |
            sort -u
    elif command -v getent >/dev/null 2>&1; then
        getent ahostsv4 "$d" 2>/dev/null |
            awk '{print $1}' |
            sort -u
    else
        curl -4fsS --max-time 10 \
            "https://dns.google/resolve?name=$d&type=A" 2>/dev/null |
            grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' |
            sort -u
    fi
}

# Baca A record langsung dari Cloudflare API.
# Format stdout:
#   id<TAB>content<TAB>proxied
cf_a_records_authoritative() {
    local name="$1" response
    response=$(cf_find_all_name "$name") || return 1
    cf_json_ok "$response" || return 1

    printf '%s' "$response" |
        jq -r '.result[]
            | select(.type == "A")
            | [.id, .content, (.proxied|tostring)]
            | @tsv'
}

info "Mengecek DNS authoritative Cloudflare..."

CF_ORIGIN_AUTH=$(cf_a_records_authoritative "$ORIGIN_DOMAIN" || true)

echo
echo "=== CLOUDFLARE AUTHORITATIVE ==="
echo "Origin       : $ORIGIN_DOMAIN"
echo "  A → ${CF_ORIGIN_AUTH:-TIDAK ADA}"
echo "CloudFront   : $CF_DOMAIN"
echo "  CNAME → $CLOUDFRONT_DISTRIBUTION_DOMAIN"
echo "  Proxy       : DNS Only 🔘"
echo

CF_ORIGIN_IP=$(printf '%s\n' "$CF_ORIGIN_AUTH" |
    awk -F '\t' -v ip="$ORIGIN_IP" '$2 == ip {print $2; exit}')

if [ "$CF_ORIGIN_IP" = "$ORIGIN_IP" ]; then
    ok "Cloudflare authoritative $ORIGIN_DOMAIN → $ORIGIN_IP."
else
    error "Cloudflare authoritative $ORIGIN_DOMAIN belum mengarah ke $ORIGIN_IP."
    printf '%s\n' "${CF_ORIGIN_AUTH:-tidak ada}" | sed 's/\t/ → /g'
    die "Record DNS origin CloudFront tidak sesuai."
fi

CF_CF_AUTH_ALL=$(cf_find_all_name "$CF_DOMAIN" 2>/dev/null || true)
CF_CF_CNAME=$(printf '%s' "$CF_CF_AUTH_ALL" |
    jq -r '.result[] | select(.type=="CNAME") | .content' | head -n1)

if [ "$CF_CF_CNAME" = "$CLOUDFRONT_DISTRIBUTION_DOMAIN" ]; then
    ok "Cloudflare authoritative $CF_DOMAIN → $CLOUDFRONT_DISTRIBUTION_DOMAIN 🔘."
else
    warn "$CF_DOMAIN belum menunjuk ke CloudFront distribution. Sinkronisasi akan memperbaikinya."
fi

info "Mengecek DNS publik (informasi propagasi)..."
DNS_ORIGIN_LIST=$(resolve_a_all "$ORIGIN_DOMAIN")
DNS_CF_LIST=$(resolve_a_all "$CF_DOMAIN")

echo
echo "=== DNS PUBLIC ==="
echo "Origin       : $ORIGIN_DOMAIN"
echo "DNS          : ${DNS_ORIGIN_LIST:-belum terlihat}"
echo "CloudFront   : $CF_DOMAIN"
echo "DNS          : ${DNS_CF_LIST:-belum terlihat}"
echo

# ============================================================
# BACKUP
# ============================================================

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="$BACKUP_ROOT/$TIMESTAMP"

mkdir -p "$BACKUP_DIR"

cp -a "$XRAY_CONF" "$BACKUP_DIR/xray.conf" 2>/dev/null || true
cp -a "$DEFAULT_CONF" "$BACKUP_DIR/default.conf" 2>/dev/null || true
cp -a "$CERT_FILE" "$BACKUP_DIR/xray.crt" 2>/dev/null || true
cp -a "$KEY_FILE" "$BACKUP_DIR/xray.key" 2>/dev/null || true
cp -a "$CF_NGINX_CONF" "$BACKUP_DIR/cloudfront-nginx.conf" 2>/dev/null || true

ok "Backup dibuat:"
echo "  $BACKUP_DIR"
echo

# ============================================================
# UPDATE CLOUDFRONT NGINX
# ============================================================

info "Memperbarui konfigurasi Nginx CloudFront..."

cat > "$CF_NGINX_CONF" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $CF_DOMAIN;
    location / {
        return 301 https://\$host\$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $CF_DOMAIN;
    ssl_certificate $CERT_FILE;
    ssl_certificate_key $KEY_FILE;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /vmess-cloudfront {
        proxy_pass http://127.0.0.1:10010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /vless-cloudfront {
        proxy_pass http://127.0.0.1:10011;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location = /trojan-cloudfront {
        proxy_pass http://127.0.0.1:10012;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
    location / { return 404; }
}
EOF

# ============================================================
# SIMPAN DOMAIN BARU
# ============================================================

printf '%s\n' "$NEW_DOMAIN" > "$DOMAIN_FILE"
chmod 600 "$DOMAIN_FILE"

ok "Domain baru disimpan ke $DOMAIN_FILE"

# ============================================================
# UPDATE SERVER_NAME
# ============================================================

info "Mengubah konfigurasi server_name..."

update_server_name() {
    local file="$1"

    [ -f "$file" ] || return 0

    if grep -qE '^[[:space:]]*server_name[[:space:]]+' "$file"; then
        sed -i -E \
            "0,/^[[:space:]]*server_name[[:space:]]+[^;]+;/s//server_name $NEW_DOMAIN;/" \
            "$file"
    fi
}

update_server_name "$XRAY_CONF"
update_server_name "$DEFAULT_CONF"

# ============================================================
# STOP NGINX
# ============================================================

cd "$MARZBAN_DIR"

info "Menghentikan Nginx sementara..."
docker compose stop nginx >/dev/null 2>&1 || true
sleep 2

# ============================================================
# AUTO FIX-SSL
# ============================================================

echo
info "Memeriksa SSL origin untuk AWS CloudFront..."

# AWS CloudFront melakukan TLS ke custom origin:
# origin.<domain>:443. Karena itu sertifikat VPS cukup mencakup ORIGIN_DOMAIN.
# Sertifikat viewer untuk cf.<domain> berada di AWS ACM, bukan di VPS.

CERT_ORIGIN_OK=0
if [ -f "$CERT_FILE" ] &&
   openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null | grep -Fq "DNS:$ORIGIN_DOMAIN"; then
    CERT_ORIGIN_OK=1
fi

if [ "$CERT_ORIGIN_OK" = "1" ]; then
    ok "SSL VPS sudah mencakup origin $ORIGIN_DOMAIN."
else
    warn "SSL VPS belum mencakup $ORIGIN_DOMAIN. Menerbitkan sertifikat origin..."

    docker compose stop nginx >/dev/null 2>&1 || true
    sleep 2

    ACME_HOME="${HOME}/.acme.sh"
    ACME_BIN="$ACME_HOME/acme.sh"
    if [ ! -x "$ACME_BIN" ] && command -v acme.sh >/dev/null 2>&1; then
        ACME_BIN="$(command -v acme.sh)"
    fi

    [ -x "$ACME_BIN" ] || die "acme.sh tidak ditemukan untuk SSL origin CloudFront."

    ACME_DOMAIN_DIR="$ACME_HOME/${ORIGIN_DOMAIN}_ecc"
    if ! "$ACME_BIN" --issue --standalone \
        -d "$ORIGIN_DOMAIN" \
        --keylength ec-256 \
        --server letsencrypt \
        --force; then
        die "SSL origin $ORIGIN_DOMAIN gagal diterbitkan."
    fi

    if [ ! -f "$ACME_DOMAIN_DIR/fullchain.cer" ] || [ ! -f "$ACME_DOMAIN_DIR/${ORIGIN_DOMAIN}.key" ]; then
        die "File sertifikat origin tidak ditemukan setelah issue SSL."
    fi

    install -m 600 "$ACME_DOMAIN_DIR/fullchain.cer" "$CERT_FILE"
    install -m 600 "$ACME_DOMAIN_DIR/${ORIGIN_DOMAIN}.key" "$KEY_FILE"

    openssl x509 -in "$CERT_FILE" -noout -text 2>/dev/null |
        grep -Fq "DNS:$ORIGIN_DOMAIN" ||
        die "Sertifikat baru tidak memiliki SAN $ORIGIN_DOMAIN."

    ok "SSL origin berhasil diterbitkan untuk $ORIGIN_DOMAIN."
fi

# Tidak ada Cloudflare orange-cloud di sini.
# cf.<domain> tetap DNS Only dan CNAME ke AWS CloudFront.
ok "$CF_DOMAIN tetap DNS Only 🔘 → $CLOUDFRONT_DISTRIBUTION_DOMAIN."

# ============================================================
# TUNGGU MARZBAN SIAP
# ============================================================

info "Menunggu Marzban siap..."

for i in $(seq 1 30); do
    if ss -lntp 2>/dev/null | grep -q ':12800 '; then
        break
    fi
    sleep 2
done

# Pastikan container aktif.
docker compose up -d marzban nginx >/dev/null 2>&1 || true

sleep 5

# ============================================================
# TOKEN MARZBAN — TIDAK DIBUAT OTOMATIS
# ============================================================
# Domain changer hanya bertugas mengganti domain, DNS Cloudflare,
# SSL, Nginx, dan konfigurasi Marzban. Jangan menjalankan `buat_token`
# otomatis karena command tersebut dapat menunggu service/API dan membuat
# script terlihat hang setelah SSL selesai.
# Token Marzban dapat dibuat manual jika memang diperlukan oleh instalasi.

info "Melewati pembuatan token API Marzban otomatis."
ok "Tidak ada proses buat_token yang dijalankan oleh ganti_domain."

# ============================================================
# FINAL RESTART
# ============================================================

info "Menjalankan ulang Marzban dan Nginx..."

docker compose up -d marzban nginx >/dev/null 2>&1 || {
    warn "Gagal menjalankan ulang Marzban/Nginx."
}

sleep 3

# ============================================================
# VERIFY DOMAIN
# ============================================================

echo
echo "============================================================"
echo "                 VERIFIKASI DOMAIN"
echo "============================================================"

STORED_DOMAIN=$(cat "$DOMAIN_FILE" 2>/dev/null)

echo "Domain tersimpan : $STORED_DOMAIN"

if [ "$STORED_DOMAIN" = "$NEW_DOMAIN" ]; then
    ok "Domain berhasil disimpan."
else
    warn "Domain file tidak sesuai."
fi

if [ -f "$DEFAULT_CONF" ]; then
    if grep -q "server_name $NEW_DOMAIN;" "$DEFAULT_CONF"; then
        ok "Nginx server_name sudah menggunakan domain baru."
    fi
fi

echo
echo "============================================================"
echo "             GANTI DOMAIN SELESAI"
echo "============================================================"
echo
echo "Domain utama : $NEW_DOMAIN"
echo "Origin       : $ORIGIN_DOMAIN → $ORIGIN_IP 🔘"
echo "CloudFront   : $CF_DOMAIN → $CLOUDFRONT_DISTRIBUTION_DOMAIN 🔘"
echo "SSL origin   : $CERT_FILE"
echo "Backup      : $BACKUP_DIR"
echo "CF API      : $CF_API_CONF"
echo "Wildcard    : TIDAK disentuh"
echo
echo "Cloudflare otomatis:"
echo "  $ORIGIN_DOMAIN → $ORIGIN_IP 🔘 (DNS Only)"
echo "  $CF_DOMAIN → $CLOUDFRONT_DISTRIBUTION_DOMAIN 🔘 (CNAME / DNS Only)"
echo
echo "============================================================"
